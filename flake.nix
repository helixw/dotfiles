                  export N8N_USER_FOLDER="$XDG_CONFIG_HOME/n8n"

                  # Enforce recommended file permissions for n8n config
                  export N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
                '';
              };

              # Application configuration activation scripts
              home.activation = {

