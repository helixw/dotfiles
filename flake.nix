{
  description = "Aurelia nix-darwin system flake";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    nix-darwin.url = "github:LnL7/nix-darwin";
    nix-darwin.inputs.nixpkgs.follows = "nixpkgs";
    nix-homebrew.url = "github:zhaofengli-wip/nix-homebrew";
    # Pin Homebrew sources to the current release. The pin must stay recent:
    # the cask/formula JSON API is generated by upstream's latest brew, and
    # an older pinned brew crashes deserializing stanzas it doesn't know
    # (e.g. `depends_on :macos` in 5.1.x, `postflight_steps` in 6.0.x).
    brew-src = {
      url = "github:Homebrew/brew/6.0.11";
      flake = false;
    };
    nix-homebrew.inputs.brew-src.follows = "brew-src";
    home-manager.url = "github:nix-community/home-manager";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = inputs@{ self, nix-darwin, nixpkgs, nix-homebrew, home-manager, ... }: let
    # Paths two independent consumers must agree on: the scheduled agent and the
    # interactive `dr` take the same lock, and the agent's script and launchd's
    # own redirects write the same log. The stamp carries the date of the last
    # run start, which is what makes the catch-up fire at most once a day.
    maintenanceLock = "/Users/helixw/Library/Caches/dotfiles-system-maintenance.lock";
    maintenanceStamp = "/Users/helixw/Library/Caches/dotfiles-system-maintenance.last-run";
    maintenanceLog = "/Users/helixw/Library/Logs/morning-maintenance.log";
    # THE TRIGGER QUEUES the private-office hub asks for off-schedule runs
    # through. Each is created at activation because launchd can only watch a
    # path that exists when the job loads, and each belongs to exactly ONE
    # routine: a second routine wanting a queue gets its own directory rather
    # than sharing one, since two watchers on one directory drain each other's
    # requests.
    #
    # THE CONTRACT, which the hub states in full at its own end
    # (~/Code/private-office/app/server/config.ts, the host-run trigger queues)
    # and which both repos must hold to the letter:
    #   - the hub adds ONE FILE PER PRESS, named
    #     run-<arrival instant>-<uuid>.json, and never removes it. The NAME is
    #     the whole request: an entry appears under its final name already, so
    #     seeing it is enough and the body, one JSON object of {requested_at}
    #     plus an optional {argument}, is read tolerantly for the log alone. The
    #     instant is ISO 8601 with : and . written as -, so it is fixed-width
    #     and big-endian and a plain `sort` on the names IS arrival order;
    #   - a watcher registers with QueueDirectories and NEVER WatchPaths, and
    #     DRAINS ITS QUEUE COMPLETELY before doing any work. Both halves are
    #     load-bearing and both are measured, at the agents below;
    #   - whether N drained requests are ONE run or N is the watcher's own call,
    #     and the ARGUMENT decides it. A routine taking none COLLAPSES them,
    #     brew being no better for running twice, which is what both agents
    #     below do. A routine whose request CARRIES a value acts on EVERY
    #     drained request IN ARRIVAL ORDER, two presses being two different
    #     formulae; that watcher sorts its listing, and the name is spelled to
    #     make a plain sort enough.
    #
    # UNTIL 2026-08-24 each queue was ONE EXACT FILENAME the hub renamed onto,
    # which meant a second press before the first was consumed OVERWROTE it. That
    # is what broke for the user: two presses 1.46 seconds apart, the first run
    # and the second left on disk unconsumed for ten hours, because WatchPaths is
    # "highly race-prone, and it is entirely possible for modifications to be
    # missed" (launchd.plist(5)) and does not replay a write that lands while the
    # job it woke is still running.
    maintenanceTriggerDir = "/Users/helixw/.private-office/triggers";
    # The SECOND queue the rule above promised, for the hub's Shopping Research
    # routine, and its own log and lock. Same contract exactly.
    #
    # WHY IT RUNS HERE AT ALL: the routine spawns the `claude` CLI on the user's
    # own subscription, and that binary and its credentials live on this Mac and
    # not in the hub's image, so the container can only ask.
    shoppingTriggerDir = "/Users/helixw/.private-office/triggers-shopping";
    shoppingLock = "/Users/helixw/Library/Caches/private-office-shopping-research.lock";
    shoppingLog = "/Users/helixw/Library/Logs/shopping-research.log";
    # The THIRD queue, for the hub's Declare Formula routine, and the first whose
    # requests CARRY A VALUE: the formula name a person typed. That one field is
    # what puts this watcher on the other side of the collapse rule above. It acts
    # on EVERY drained request and never on just the last, because two presses are
    # two different formulae, and it takes them IN ARRIVAL ORDER by sorting the
    # listing, which the hub spells its filenames to make sufficient.
    #
    # WHY IT RUNS HERE AT ALL: the work is an edit to this very file, and it needs
    # `nix`, `brew`, `git` and this checkout, none of which exist in the hub's
    # container. It NEVER activates. Declaring a formula puts it in this list;
    # installing it is `darwin-rebuild`, which stays the user's own hand.
    systemTriggerDir = "/Users/helixw/.private-office/triggers-system";
    declareFormulaLog = "/Users/helixw/Library/Logs/declare-formula.log";
    # WHAT THE HUB READS THIS LIST FROM, and the one thing this machine publishes
    # for it. The authoritative answer is `nix eval` against this flake, which
    # needs the /nix store and this checkout; the hub has neither where it serves
    # (its own app/server/config.ts states that at SYSTEM_BREWS), so the answer is
    # published as one JSON document into the artifacts directory it already binds
    # read only. Every write of it goes through publishBrews below.
    brewsArtifact = "/Users/helixw/.private-office/artifacts/system/brews.json";
    # THE OTHER HALF OF THAT REPORT, and the only way a REFUSAL can reach the
    # user's screen at all. A declare that fails leaves the queue empty and the
    # brews list unchanged, which is exactly what a press the watcher has not
    # reached yet looks like, so until this document existed the hub's row went
    # quietly back to "No Run Yet" and the reason lived only in the log below and
    # in one notification. It is written on a refusal and removed the moment this
    # watcher has fresh work to report on, so its presence IS the report.
    #
    # The hub reads it through the same read-only bind as the list, and it is the
    # hub that turns the `reason` word into a sentence (its own
    # app/server/modules/system/routines.ts holds those words, and this file must
    # not write prose for a surface it cannot see).
    declareFailureArtifact = "/Users/helixw/.private-office/artifacts/system/declare-formula-failure.json";
    # This repo, addressed absolutely rather than as a working directory: a
    # launchd job starts in / and has no notion of where its own source lives.
    dotfilesDir = "/Users/helixw/Code/dotfiles";
    # The one host this flake configures, spelled once: the configuration below is
    # named with it, and the two scripts evaluate that configuration by name.
    darwinHost = "aurelia";

    configuration = { pkgs, config, ... }: let
      # Unattended Software Update run. Runs as the login user: no root, no
      # secrets, and macOS updates are listed only, never installed. Casks whose
      # artifacts carry a pkg stanza run an installer that asks for sudo, which
      # there is no tty to answer, so the outdated list is filtered against
      # brew's own metadata at run time and those are left to the interactive
      # run.
      morningMaintenance = pkgs.writeShellScript "morning-maintenance" ''
        set -u

        BREW=/opt/homebrew/bin/brew
        LOG="${maintenanceLog}"
        STAMP="${maintenanceStamp}"
        TRIGGERS="${maintenanceTriggerDir}"
        TODAY=$(date '+%Y-%m-%d')

        export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
        export HOMEBREW_NO_ENV_HINTS=1

        log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

        # Two ways in, one script. A SCHEDULED run (08:00, or the catch-up at
        # load) dedupes on the date stamp below and is unchanged. A REQUESTED
        # run, which the private-office hub asks for by adding run-<uuid>.json to
        # $TRIGGERS, bypasses that stamp for that run alone. The queue is drained
        # BEFORE any work, so a run that dies midway cannot re-fire forever.
        #
        # EVERY ENTRY IS DELETED, recognised or not, and that is mandatory rather
        # than tidiness. QueueDirectories keeps this job alive for as long as the
        # directory is not empty, so one file left behind relaunches it every 10
        # seconds forever (measured 2026-08-24; 10 seconds is launchd's default
        # ThrottleInterval). The old rule here was the opposite, to report an
        # unexpected file and leave it in place, which under this mechanism would
        # be a respawn loop. Deleting is in scope because this directory is the
        # contract's own and holds nothing else by construction.
        #
        # WHAT IS DELETED IS EXACTLY WHAT WAS LISTED, which is why the listing
        # goes to a file first rather than being re-globbed at the rm. A press
        # landing between the two would otherwise be deleted without ever being
        # run, which is the very class of loss this whole mechanism replaced;
        # this way it survives, leaves the queue non-empty, and earns its own
        # relaunch the moment this run exits.
        force=0
        drained=$(mktemp -t private-office-maintenance-drain)
        find "$TRIGGERS" -mindepth 1 -maxdepth 1 > "$drained" 2>/dev/null || true
        requests=$(grep -c '/run-[^/]*\.json$' "$drained" || true)
        while IFS= read -r entry; do
          case "$entry" in
            */run-*.json)
              requested_at=$(jq -r '.requested_at // "unknown"' < "$entry" 2>/dev/null || echo unknown)
              log "request drained ($(basename "$entry"), requested_at $requested_at)"
              ;;
            *)
              log "unrecognised entry drained from $TRIGGERS: $(basename "$entry")"
              ;;
          esac
          rm -rf -- "$entry"
        done < "$drained"
        rm -f "$drained"
        if [ "$requests" -gt 0 ]; then
          force=1
          log "$requests request(s) drained; running now and skipping the day stamp"
        fi

        # The agent also runs at load, so a Mac that was asleep at 08:00 catches
        # up at the next login. A day already covered exits here, which keeps
        # every later login of that day silent apart from this one line.
        if [ "$force" -eq 0 ] && [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$TODAY" ]; then
          log "already ran today; skipping"
          exit 0
        fi

        # Stamped at the start, not the end, so a run that dies midway still
        # counts as today's attempt rather than re-firing at every login.
        mkdir -p "$(dirname "$STAMP")"
        printf '%s\n' "$TODAY" > "$STAMP"

        # Trim in place so launchd's append handle keeps pointing at this inode.
        if [ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 5000 ]; then
          tail -n 2000 "$LOG" > "$LOG.trim" && cat "$LOG.trim" > "$LOG"
          rm -f "$LOG.trim"
        fi

        failed=""

        log "brew update"
        # Metadata is fresh only when the update succeeded, so the suppression
        # is set on that branch alone and a failed update leaves brew free to
        # auto-update itself on the commands that follow.
        if "$BREW" update; then
          export HOMEBREW_NO_AUTO_UPDATE=1
        else
          failed="''${failed:+$failed, }brew-update"
        fi

        # Captured before the upgrade, so the verification phase below knows
        # which formulae moved and therefore whose dependents can be orphaned.
        outdated_formulae=$("$BREW" outdated --formula --quiet || true)

        # --yes because ask mode is brew's default and would hang unattended.
        log "brew upgrade (formulae)"
        "$BREW" upgrade --formula --yes || failed="''${failed:+$failed, }brew-upgrade-formula"

        log "brew upgrade (casks, excluding pkg installers)"
        # A bare --cask with no names upgrades every cask, so a token list
        # reaches brew only when it is known to be non-empty.
        outdated=$("$BREW" outdated --cask --quiet || true)
        if [ -z "$outdated" ]; then
          log "no casks to upgrade"
        else
          # Which casks need sudo is read from brew's own metadata rather than
          # named here, so a cask that gains or drops a pkg installer upstream
          # is handled without an edit.
          # Intentional word splitting: one cask token per line.
          # shellcheck disable=SC2086
          cask_json=$("$BREW" info --json=v2 --cask $outdated)
          info_rc=$?
          pkg_casks=$(printf '%s' "$cask_json" | jq -r '.casks[] | select([.artifacts[]? | objects | has("pkg")] | any) | .token')
          jq_rc=$?

          if [ "$info_rc" -ne 0 ] || [ "$jq_rc" -ne 0 ]; then
            # jq reports an empty selection and a missing document the same way,
            # so without a clean read a pkg cask could reach brew and stall on a
            # sudo prompt that has no tty. The phase is skipped instead.
            log "cask metadata unavailable; skipping cask upgrades"
            failed="''${failed:+$failed, }brew-cask-metadata"
          else
            if [ -n "$pkg_casks" ]; then
              log "leaving pkg-installer casks to the interactive run: $(printf '%s' "$pkg_casks" | tr '\n' ' ')"
              casks=$(printf '%s\n' "$outdated" | grep -vxF "$pkg_casks" || true)
            else
              casks="$outdated"
            fi

            if [ -z "$casks" ]; then
              log "no casks to upgrade"
            else
              # Intentional word splitting: one cask token per line.
              # shellcheck disable=SC2086
              "$BREW" upgrade --cask --yes $casks || failed="''${failed:+$failed, }brew-upgrade-cask"
            fi
          fi
        fi

        # Post-upgrade linkage verification, repaired in the same run.
        #
        # WORKED CASE, 2026-08-18: simdutf moved to 9.1.0, which ships
        # libsimdutf.35 only, while the installed merve 1.2.2_1 still linked
        # libsimdutf.34, so every Homebrew node invocation aborted on a dyld
        # "Library not loaded" and exited 134. Nothing in the run noticed.
        #
        # DETECTOR, chosen on evidence rather than on the obvious candidates:
        #   * `brew missing` does not see this class at all (verified
        #     2026-08-18: no output, exit 0, while node was aborting).
        #   * `brew linkage` does see it, but it is a developer command and
        #     switches Homebrew's developer mode on in order to run. That mode
        #     is off on this machine and deliberately kept off, and an
        #     unattended job is the wrong thing to turn it on.
        #   * Running each dependent with --version and reading the exit code is
        #     neither side-effect free nor reliable: pdftotext reads --version
        #     as an input FILENAME and does file I/O for it, and a binary that
        #     merely rejects an unknown flag exits nonzero having loaded fine.
        # So this reads Mach-O load commands and executes nothing: otool -L over
        # each candidate's own binaries and libraries, flagging absolute
        # references under the Homebrew prefix whose target no longer exists.
        # That is the exact shape of the merve break, whose dylib names
        # /opt/homebrew/opt/simdutf/lib/libsimdutf.NN.dylib outright, and the
        # file carrying the dangling reference names the formula to repair.
        # References under /usr/lib are skipped on purpose: they live in the
        # dyld shared cache and have no file on disk to test. Symlinked entries
        # are skipped too, since the real file sits in its OWN formula's prefix
        # and that formula is scanned under its own name.
        #
        # Prints one formula name per line.
        broken_formulae() {
          for bf_name in "$@"; do
            bf_prefix=$("$BREW" --prefix --installed "$bf_name" 2>/dev/null) || continue
            [ -n "$bf_prefix" ] || continue
            find -H "$bf_prefix/bin" "$bf_prefix/sbin" "$bf_prefix/lib" \
              -maxdepth 2 -type f -print 2>/dev/null |
            while read -r bf_file; do
              /usr/bin/otool -L "$bf_file" 2>/dev/null |
                sed -n 's|^[[:space:]]*\(/opt/homebrew/[^[:space:]]*\).*|\1|p' |
                while read -r bf_target; do
                  if [ ! -e "$bf_target" ]; then
                    printf '%s\n' "$bf_name"
                  fi
                done
            done
          done | sort -u
        }

        log "verifying linkage of upgraded formulae and their dependents"
        if [ -z "$outdated_formulae" ]; then
          log "no formulae were upgraded; nothing to verify"
        else
          # `brew uses` intersects when given several formulae at once, so the
          # dependents are resolved one upgraded formula at a time.
          candidates=$(
            printf '%s\n' "$outdated_formulae"
            for uf in $outdated_formulae; do
              "$BREW" uses --installed --recursive --formula "$uf" 2>/dev/null
            done
          )
          candidates=$(printf '%s\n' "$candidates" | sort -u)
          # Intentional word splitting: one formula token per line.
          # shellcheck disable=SC2086
          broken=$(broken_formulae $candidates)

          if [ -z "$broken" ]; then
            log "linkage clean across $(printf '%s\n' "$candidates" | wc -l | tr -d ' ') formulae"
          else
            log "orphaned linkage: $(printf '%s' "$broken" | tr '\n' ' ')"
            # Only the orphaned formula is touched. Repouring it relinks it
            # against the prefix as it now stands, which is what the upgrade
            # ordering left stale; a bare `brew upgrade` of everything would be
            # a second, unscoped upgrade phase and is never run here.
            for bf in $broken; do
              log "repairing $bf (brew reinstall)"
              "$BREW" reinstall --formula "$bf" || log "reinstall of $bf failed"
            done

            # Intentional word splitting: one formula token per line.
            # shellcheck disable=SC2086
            still_broken=$(broken_formulae $broken)
            if [ -n "$still_broken" ]; then
              # Repouring cannot fix a formula whose published bottle is itself
              # built against a version that is gone; that needs the user.
              log "STILL BROKEN after repair: $(printf '%s' "$still_broken" | tr '\n' ' ')"
              failed="''${failed:+$failed, }brew-linkage-unrepaired"
            else
              log "repaired: $(printf '%s' "$broken" | tr '\n' ' ')"
              /usr/bin/osascript -e "display notification \"Repaired: $(printf '%s' "$broken" | tr '\n' ' ')\" with title \"Software Update\"" || true
            fi
          fi
        fi

        log "brew cleanup"
        "$BREW" cleanup || failed="''${failed:+$failed, }brew-cleanup"

        # Report only. Installing macOS updates needs root and stays manual.
        log "softwareupdate --list"
        /usr/sbin/softwareupdate --list || failed="''${failed:+$failed, }softwareupdate-list"

        # The hub's copy of the declared formulae, refreshed on the daily run so
        # that a formula added to this file BY HAND reaches the page too, and not
        # only one added through the watcher below, which republishes for itself.
        #
        # IT DOES NOT JOIN "$failed", which is deliberate and not an oversight.
        # That list is a VOCABULARY THE HUB RENDERS, each token mapped to a
        # sentence in its own maintenance module, so a token invented here would
        # reach the user as a raw word. And what this failing costs is the
        # PREVIOUS list, which was true when it was written, rather than a wrong
        # one; the next declare or the next morning replaces it.
        log "publishing the declared formulae for the hub"
        ${publishBrews} || log "the declared formulae could not be republished"

        if [ -n "$failed" ]; then
          log "FAILED: $failed"
          /usr/bin/osascript -e "display notification \"Failed: $failed\" with title \"Software Update\"" || true
          exit 1
        fi

        log "done"
      '';

      # The private-office hub's Shopping Research routine, run HERE because the
      # hub serves from a container and the `claude` CLI it spawns, with the
      # user's subscription credentials, is on this machine.
      #
      # IT HOLDS NO COPY OF THE ROUTINE. The work is one call into that repo's
      # own CLI, so the run this starts is byte for byte the run a terminal
      # starts and there is nothing here to drift from it. What this script owns
      # is only the trigger contract: read one exact filename, consume it, and
      # decide whether to run.
      shoppingResearch = pkgs.writeShellScript "shopping-research" ''
        set -u

        BUN=/opt/homebrew/bin/bun
        APP=/Users/helixw/Code/private-office/app
        TRIGGERS="${shoppingTriggerDir}"
        LOG="${shoppingLog}"

        # PATH resolves bun and claude; HOME and USER are exported rather than
        # inherited because the routine passes exactly these three on to the
        # `claude` child (that repo's enrich.ts states the measurement, USER
        # being what reaches the subscription), and a launchd job is not a login
        # shell.
        export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
        export HOME=/Users/helixw
        export USER=helixw

        log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

        # NO SCHEDULE AND NO CATCH-UP, which is the one place this differs from
        # the Software Update agent above: every run here was asked for by a
        # person a moment ago, so there is no dedupe stamp to keep and nothing to
        # catch up on. The job launches on its queue being non-empty alone, and a
        # request added while this agent was not loaded is picked up the moment it
        # loads, the queue still holding it.
        #
        # THE DRAIN IS THE SAME ONE THE AGENT ABOVE DOES and its reasoning is
        # stated there in full: every entry goes, recognised or not, because
        # QueueDirectories relaunches this job every 10 seconds for as long as
        # anything is left; and exactly what was LISTED is what is deleted, so a
        # press landing mid-drain survives to earn its own relaunch instead of
        # being swept away unrun.
        #
        # N REQUESTS ARE ONE SWEEP. A sweep works from the Inbox as it stands
        # when it starts, so two presses seconds apart describe the same work and
        # running it twice would spend the user's subscription twice over the same
        # rows. What each drained request buys is the guarantee that a sweep
        # happens AFTER it, which the relaunch gives.
        drained=$(mktemp -t private-office-shopping-drain)
        find "$TRIGGERS" -mindepth 1 -maxdepth 1 > "$drained" 2>/dev/null || true
        requests=$(grep -c '/run-[^/]*\.json$' "$drained" || true)
        while IFS= read -r entry; do
          case "$entry" in
            */run-*.json)
              requested_at=$(jq -r '.requested_at // "unknown"' < "$entry" 2>/dev/null || echo unknown)
              log "request drained ($(basename "$entry"), requested_at $requested_at)"
              ;;
            *)
              log "unrecognised entry drained from $TRIGGERS: $(basename "$entry")"
              ;;
          esac
          rm -rf -- "$entry"
        done < "$drained"
        rm -f "$drained"

        # A launch with nothing to run is ordinary rather than exceptional: it is
        # what the relaunch after a drain always finds, and what an unrecognised
        # file alone would produce. Nothing here has a schedule, so no request
        # means no work.
        if [ "$requests" -eq 0 ]; then
          log "no request in the queue; nothing to do"
          exit 0
        fi

        log "$requests request(s) drained; running Shopping Research"
        if "$BUN" run --cwd "$APP" office run shopping-enrichment; then
          log "done"
        else
          rc=$?
          # The hub cannot report this. Its status row reads the run state of its
          # OWN process, and this run is not in it, so a failure here is visible
          # nowhere on screen unless it is said out loud.
          log "FAILED (exit $rc)"
          /usr/bin/osascript -e "display notification \"The run failed (exit $rc); see $LOG\" with title \"Shopping Research\"" || true
          exit 1
        fi
      '';

      # PUBLISHING WHAT THIS FLAKE DECLARES, so the hub can show it. It is one
      # command, kept in one place because two callers run it: the Declare Formula
      # watcher below republishes after every formula it adds, a list still
      # missing what the user just asked for reading exactly like a press that did
      # nothing; and the Software Update run republishes daily, so a formula added
      # by hand in an editor reaches the page as well.
      #
      # NIX EVAL RATHER THAN A PARSE OF THIS FILE, which is forced rather than
      # preferred: the evaluated value is what darwin-rebuild would actually
      # apply, and it resolves BOTH declaration forms this file uses, the bare
      # string and the { name = ...; trusted = ...; } attribute set, into one
      # shape carrying one fully qualified name. A regex over the source would
      # have to reinvent that and would break the day this block changes shape.
      #
      # WRITTEN THROUGH A RENAME inside the artifacts directory itself, so a
      # reader on the other side of the bind mount sees the previous document or
      # the new one and never a half written one.
      publishBrews = pkgs.writeShellScript "publish-brews" ''
        set -u

        NIX=/nix/var/nix/profiles/default/bin/nix
        OUT="${brewsArtifact}"

        mkdir -p "$(dirname "$OUT")" || exit 1
        pb_tmp=$(mktemp "$OUT.XXXXXX") || exit 1
        if "$NIX" eval "${dotfilesDir}#darwinConfigurations.${darwinHost}.config.homebrew.brews" --json > "$pb_tmp"; then
          # The mode mktemp gives is the one the temporary file needed, not the
          # one a published document wants; the hub reads this through a bind
          # mount and every other artifact under there is world readable.
          chmod 644 "$pb_tmp"
          mv -f "$pb_tmp" "$OUT"
          exit 0
        fi
        rm -f "$pb_tmp"
        exit 1
      '';

      # THE HUB'S Declare Formula ROUTINE, run here because the work IS an edit to
      # this file: it needs nix, brew, git and this checkout, and the hub's
      # container has none of them. It validates the name against Homebrew, adds
      # it to the brews list above, commits, republishes the list for the hub, and
      # stops there. What it could NOT do until 2026-08-24 is tell the hub that it
      # said no, so a refusal now publishes a document of its own beside that list
      # (declareFailureArtifact above) and every refusal below goes through the one
      # `refuse` call that writes it.
      #
      # WHAT IT WILL NOT DO, in the order that matters:
      #   - it NEVER runs darwin-rebuild. Declaring is not installing, and
      #     activation is always the user's own hand;
      #   - it never TRUSTS A NEW TAP. A formula whose tap this flake does not
      #     already declare trusted is a stop: no edit, no commit, and the reason
      #     said out loud. HOMEBREW_REQUIRE_TAP_TRUST exists to make trusting a
      #     third party a deliberate act, and a name typed into a page is not one;
      #   - it never touches a flake.nix carrying uncommitted work. Its commit is
      #     path limited, but an edit of the user's in flight is theirs to finish.
      #
      # ITS VALIDATION IS `brew info`, WHICH READS AND CHANGES NOTHING. Exit 0
      # with JSON means the name resolves to a real formula and exit 1 means it
      # does not, both verified live 2026-08-24. HOMEBREW_NO_AUTO_UPDATE stops
      # brew refreshing its API cache first, which is the only part of that read
      # that would touch the network, and the cache it answers from is refreshed
      # every morning by the Software Update run above. `brew cat` and `brew
      # linkage` are deliberately NOT used: both are developer commands that
      # switch Homebrew's developer mode on, which this machine keeps off (the
      # linkage phase above states the same finding).
      declareFormula = pkgs.writeShellScript "declare-formula" ''
        set -u

        NIX=/nix/var/nix/profiles/default/bin/nix
        BREW=/opt/homebrew/bin/brew
        GIT=/usr/bin/git
        DOTFILES="${dotfilesDir}"
        FLAKE="${dotfilesDir}/flake.nix"
        HOMEBREW_ATTR="${dotfilesDir}#darwinConfigurations.${darwinHost}.config.homebrew"
        TRIGGERS="${systemTriggerDir}"
        LOG="${declareFormulaLog}"
        FAILURE="${declareFailureArtifact}"

        # PATH resolves brew and jq; HOME is what git reads the user's identity
        # through and what nix finds its own configuration under, and a launchd
        # job is not a login shell.
        export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
        export HOME=/Users/helixw
        export USER=helixw
        export HOMEBREW_NO_AUTO_UPDATE=1
        export HOMEBREW_NO_ANALYTICS=1
        export HOMEBREW_NO_ENV_HINTS=1

        log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }
        notify() {
          /usr/bin/osascript -e "display notification \"$1\" with title \"Declare Formula\"" || true
        }

        # PUBLISHING A REFUSAL so the hub's own row can show it, which is the
        # only surface the user is actually looking at when they press Run.
        #
        # IT WRITES A WORD AND NOT A SENTENCE. The reason is a token this file
        # and the hub agree on, and the hub owns the wording; a script writing
        # prose for a page it cannot see is how two spellings of one message
        # start. The moment is LOCAL and spelled the way that hub already reads
        # every other moment on this machine (its routine-status.ts).
        #
        # WRITTEN THROUGH A RENAME inside the artifacts directory, exactly as
        # publishBrews above writes the list, so a reader on the other side of
        # the bind mount sees the old document or the new one and never half of
        # one. It NEVER fails the run it is reporting on: this is the report,
        # and a report that cannot be filed must not become a second failure.
        record_failure() {
          mkdir -p "$(dirname "$FAILURE")" || return 0
          rf_tmp=$(mktemp "$FAILURE.XXXXXX") || return 0
          if jq -n \
            --arg failed_at "$(date '+%Y-%m-%d %H:%M:%S')" \
            --arg formula "$1" \
            --arg reason "$2" \
            '{failed_at: $failed_at, formula: $formula, reason: $reason}' > "$rf_tmp"; then
            chmod 644 "$rf_tmp"
            mv -f "$rf_tmp" "$FAILURE"
            return 0
          fi
          rm -f "$rf_tmp"
        }

        # ONE REQUEST REFUSED: said in the log in this script's words and in the
        # document in the hub's token. They are deliberately the same call, so a
        # refusal cannot be logged and left unpublished. Called only from
        # declare_formula, where df_typed is the request in hand.
        refuse() {
          log "FAILED $df_typed: $2"
          record_failure "$df_typed" "$1"
        }

        # THE DRAIN, which is the contract's and is stated in full at the first
        # agent above: every entry goes, recognised or not, because
        # QueueDirectories relaunches this job every 10 seconds for as long as
        # anything is left; and exactly what was LISTED is what is deleted, so a
        # press landing mid drain survives to earn its own relaunch.
        #
        # WHAT IS DIFFERENT HERE IS THE ORDER AND THE READING. Each request
        # carries the formula a person typed, so the body is load bearing rather
        # than a log line, and it is read BEFORE the entry is deleted. The listing
        # is sorted, which is arrival order: the hub leads every name with a fixed
        # width ISO instant precisely so that a plain sort is enough. N requests
        # are N runs, never one, because two presses are two different formulae.
        drained=$(mktemp -t private-office-declare-drain)
        requested=$(mktemp -t private-office-declare-requests)
        find "$TRIGGERS" -mindepth 1 -maxdepth 1 2>/dev/null | LC_ALL=C sort > "$drained" || true
        while IFS= read -r entry; do
          case "$entry" in
            */run-*.json)
              requested_at=$(jq -r '.requested_at // "unknown"' < "$entry" 2>/dev/null || echo unknown)
              formula=$(jq -r '.argument // empty' < "$entry" 2>/dev/null || true)
              log "request drained ($(basename "$entry"), requested_at $requested_at, formula ''${formula:-none})"
              if [ -n "$formula" ]; then
                printf '%s\n' "$formula" >> "$requested"
              else
                log "that request carried no formula name, so there is nothing to declare for it"
              fi
              ;;
            *)
              log "unrecognised entry drained from $TRIGGERS: $(basename "$entry")"
              ;;
          esac
          rm -rf -- "$entry"
        done < "$drained"
        rm -f "$drained"

        # A launch with nothing to run is ordinary rather than exceptional: it is
        # what the relaunch after a drain always finds. Nothing here has a
        # schedule, so no request means no work.
        if [ ! -s "$requested" ]; then
          log "no formula in the queue; nothing to do"
          rm -f "$requested"
          exit 0
        fi

        # THIS RUN SUPERSEDES THE LAST REPORT, so the previous refusal goes now
        # that there is fresh work to report on. A SUCCESS therefore clears the
        # document by leaving it cleared, which is what makes a declare that
        # works erase the failure before it without this script having to notice
        # that it did.
        #
        # IT IS CLEARED HERE AND NOT AT THE TOP, which is the whole reason this
        # line sits below the exit above rather than above it. QueueDirectories
        # relaunches this job once more after every drain, and that relaunch
        # finds an empty queue: clearing before that check would wipe a refusal
        # seconds after writing it, and the reader would never see one.
        rm -f "$FAILURE"

        # THE USER'S OWN EDIT COMES FIRST. A commit here is limited to flake.nix,
        # so an unrelated file in flight is safe either way, but an unfinished
        # edit to THIS file would be committed under a message about a formula.
        # Checked once for the whole run rather than per request, since the answer
        # cannot change while this job holds the only other pen.
        if ! "$GIT" -C "$DOTFILES" diff --quiet -- flake.nix ||
           ! "$GIT" -C "$DOTFILES" diff --cached --quiet -- flake.nix; then
          log "FAILED: flake.nix carries uncommitted changes, so nothing was declared"
          notify "flake.nix has uncommitted changes, so nothing was declared"
          # Reported against the LAST formula queued, which is the one the
          # person who is about to look at the page just typed. Every request in
          # this run was refused for the one reason, the log lists them all, and
          # a row can only carry one.
          record_failure "$(tail -n 1 "$requested")" flake-dirty
          rm -f "$requested"
          exit 1
        fi

        # Every formula this flake declares, under the name nix resolves it to,
        # which is what makes one read cover both declaration forms.
        declared_names() {
          "$NIX" eval "$HOMEBREW_ATTR.brews" --json | jq -r '.[].name'
        }

        # A tap as Homebrew addresses it: a repository named homebrew-tap is the
        # tap called plain tap, and case never matters.
        normalise_tap() {
          printf '%s\n' "$1" | sed 's|/homebrew-|/|' | tr '[:upper:]' '[:lower:]'
        }

        # The taps trusted at the top of the homebrew block, whose formulae need
        # nothing of their own beyond a qualified name.
        declared_taps() {
          "$NIX" eval "$HOMEBREW_ATTR.taps" --json |
            jq -r '.[] | select(.trusted) | .name' | sed 's|/homebrew-|/|'
        }

        # Every tap this flake trusts by any route, the block above plus any brew
        # entry carrying the flag itself, which is how oven-sh/bun/bun is written.
        trusted_taps() {
          declared_taps
          "$NIX" eval "$HOMEBREW_ATTR.brews" --json |
            jq -r '.[] | select(.trusted) | .name | split("/") | select(length == 3) | .[0:2] | join("/")' |
            sed 's|/homebrew-|/|'
        }

        # ADDING ONE ENTRY, at the END of the list and never in sorted position:
        # that list is grouped by purpose with a comment over each group, so an
        # alphabetical insertion would split a group and orphan its comment. The
        # closing bracket is FOUND rather than remembered, by matching the line
        # that opens the list and then the first line at the same indentation that
        # closes it, so neither a line number nor an edit elsewhere in the file
        # can send this to the wrong place.
        insert_brew() {
          ib_tmp=$(mktemp -t private-office-declare-flake) || return 1
          if awk -v entry="$1" '
            state == 0 && $0 ~ /^[[:space:]]*brews[[:space:]]*=[[:space:]]*\[[[:space:]]*$/ {
              match($0, /^[[:space:]]*/)
              indent = substr($0, 1, RLENGTH)
              closing = indent "];"
              state = 1
              print
              next
            }
            state == 1 && $0 == closing { print indent "  " entry; state = 2 }
            { print }
            END { exit(state == 2 ? 0 : 1) }
          ' "$FLAKE" > "$ib_tmp"; then
            # Written back through the same inode, so the file keeps its mode.
            cat "$ib_tmp" > "$FLAKE"
            rm -f "$ib_tmp"
            return 0
          fi
          rm -f "$ib_tmp"
          return 1
        }

        # ONE REQUEST, START TO FINISH. 0 means the formula is declared, whether
        # this run is what declared it or it was already there; 1 means it is not,
        # and the log line above the return says why in the reader's words.
        declare_formula() {
          df_typed="$1"

          # WHERE THE NAME COMES FROM decides how far this can go before touching
          # anything. A tap qualified name addresses a third party, and the tap is
          # checked HERE, before brew is called at all: `brew info` on a tap this
          # machine has never seen would clone it, which is the very trust
          # decision this must not make on the user's behalf.
          # The arms are ordered from the longest shape down, which is how a case
          # picks the right one: a formula is a bare name or exactly the three
          # segments of user/repo/formula, and anything else is neither.
          case "$df_typed" in
            */*/*/*)
              refuse not-a-formula-name "that is not a formula name"
              return 1
              ;;
            */*/*)
              df_tap=$(normalise_tap "$(dirname "$df_typed")")
              if ! trusted_taps | grep -qxF "$df_tap"; then
                refuse untrusted-tap "this flake does not trust the tap $df_tap, so nothing was declared"
                return 1
              fi
              ;;
            */*)
              refuse not-a-formula-name "that is not a formula name"
              return 1
              ;;
          esac

          if ! df_json=$("$BREW" info --formula "$df_typed" --json=v2 2>/dev/null); then
            refuse no-such-formula "Homebrew has no formula by that name"
            return 1
          fi
          df_canonical=$(printf '%s' "$df_json" | jq -r '.formulae[0].name // empty')
          df_full=$(printf '%s' "$df_json" | jq -r '.formulae[0].full_name // empty')
          df_tapname=$(printf '%s' "$df_json" | jq -r '.formulae[0].tap // empty')
          df_aliases=$(printf '%s' "$df_json" | jq -r '.formulae[0].aliases[]?')
          if [ -z "$df_full" ] || [ -z "$df_tapname" ]; then
            refuse unreadable-brew-answer "Homebrew answered nothing this could read"
            return 1
          fi

          # HOW IT WILL BE WRITTEN, in whichever of the three forms this file
          # already uses, and the last place a formula can still be refused.
          if [ "$df_tapname" = "homebrew/core" ]; then
            # The name as typed, which is what the user would have written here
            # by hand and the form every core entry above carries.
            df_name="$df_typed"
            df_entry="\"$df_typed\""
          else
            df_tap=$(normalise_tap "$df_tapname")
            df_name="$df_full"
            if declared_taps | grep -qxF "$df_tap"; then
              df_entry="\"$df_full\""
            elif trusted_taps | grep -qxF "$df_tap"; then
              # Trusted only through a brew entry of its own, so a sibling from
              # that tap carries the flag the same way bun does.
              df_entry="{ name = \"$df_full\"; trusted = true; }"
            else
              refuse untrusted-tap "this flake does not trust the tap $df_tap, so nothing was declared"
              return 1
            fi
          fi

          # THE NAME TYPED IS NOT THE ONLY NAME IT HAS, which is why the check is
          # against every name Homebrew knows rather than the one word that
          # arrived: `python` is an ALIAS of python@3.14 and this list declares
          # the alias, so a check on the typed word alone would declare a second
          # entry for a formula that is already there.
          if ! df_declared=$(declared_names); then
            refuse unreadable-declarations "the declared formulae could not be read"
            return 1
          fi
          # Intentional word splitting: one alias per line.
          # shellcheck disable=SC2086
          for df_known in "$df_typed" "$df_canonical" "$df_full" $df_aliases; do
            if printf '%s\n' "$df_declared" | grep -qxF "$df_known"; then
              log "$df_typed is already declared (as $df_known); nothing to add"
              return 0
            fi
          done

          if ! insert_brew "$df_entry"; then
            refuse insert-refused "it could not be added to the brews list"
            return 1
          fi

          # THE EDIT PROVES ITSELF BEFORE IT IS COMMITTED. The flake must still
          # evaluate AND must evaluate with this formula in it, which is one read
          # answering both questions. A file that fails it is restored, because a
          # flake.nix that does not evaluate is a machine that cannot be activated
          # at all and no one request is worth that.
          if ! declared_names | grep -qxF "$df_name"; then
            refuse flake-would-not-evaluate "the flake did not evaluate with it, so the edit was reverted"
            "$GIT" -C "$DOTFILES" checkout -- flake.nix
            return 1
          fi

          df_message=$(mktemp -t private-office-declare-message) || return 1
          printf 'feat(homebrew): declare %s\n' "$df_name" > "$df_message"
          if ! "$GIT" -C "$DOTFILES" commit -q -F "$df_message" -- flake.nix; then
            rm -f "$df_message"
            refuse commit-refused "the commit was refused, so the edit was reverted"
            "$GIT" -C "$DOTFILES" checkout -- flake.nix
            return 1
          fi
          rm -f "$df_message"

          # REPUBLISHED HERE rather than once at the end, so that a run declaring
          # three formulae shows each one as it lands.
          if ! ${publishBrews}; then
            refuse publish-refused "declared and committed, but the list the hub reads could not be republished"
            return 1
          fi

          log "declared $df_name"
          return 0
        }

        failures=0
        while IFS= read -r formula; do
          declare_formula "$formula" || failures=$((failures + 1))
        done < "$requested"
        rm -f "$requested"

        # SAID OUT LOUD AS WELL, and the "as well" is the change of 2026-08-24.
        # The last refusal is now published where the hub reads it (record_failure
        # above), so the page the user pressed Run on shows what happened rather
        # than falling silently back to "No Run Yet"; the notification stays,
        # because it is the half that reaches somebody who is no longer looking at
        # that page, and the count it carries is the one thing the single
        # published document cannot say.
        if [ "$failures" -gt 0 ]; then
          log "FAILED: $failures request(s) declared nothing"
          notify "$failures request(s) declared nothing; see $LOG"
          exit 1
        fi

        log "done"
      '';
    in {
      # Package configuration
      nixpkgs.config.allowUnfree = true;
      
      # Suppress warnings (if supported)
      warnings = [];

      # User account configuration
      users.users.helixw = {
        home = "/Users/helixw";
        shell = pkgs.zsh;
      };

      # System-wide package installation
      environment.systemPackages = [
        pkgs.vim
        pkgs.mkalias
      ];

      # Homebrew package manager configuration
      homebrew = {
        enable = true;
        # Homebrew >=6 refuses formulae/casks from untrusted third-party taps
        # (HOMEBREW_REQUIRE_TAP_TRUST is on by default), so non-official taps
        # are declared trusted here. The oven-sh/bun tap has no explicit entry
        # (it is auto-tapped via the fully-qualified brew name), so trust is
        # set on the brew entry below instead.
        taps = [
          { name = "nikitabobko/tap"; trusted = true; }
          { name = "lzhgus/homebrew-tap"; trusted = true; }
        ];
        brews = [
          "mas"
          "starship"
          "fontconfig"
          "fastfetch"
          "gnupg"
          "pinentry-mac"
          # node is here for the private-office hub's node tooling rather than
          # for its own sake, and the consumers are named so a future cleanup
          # does not read it as spare: scripts/generate_report.mjs and
          # scripts/capture_page.mjs each carry a `#!/usr/bin/env node` shebang,
          # the biome binary the lint gates invoke by path carries one too, and
          # check_report_smoke.sh runs the report generator as a commit gate, so
          # removing node fails every commit in that repo closed. This formula
          # is also what puts npm and npx on PATH, which the editor's TypeScript
          # type acquisition uses. node@22 sat beside it until 2026-08-24 as the
          # Evidence build's pinned runtime; that build was retired on
          # 2026-08-23 and the pin went with it.
          "node"
          "python"
          "tree"
          "virtualenv"
          "git-secret"
          "gh"
          "uv"
          "lefthook"
          "shellcheck"
          "poppler"
          "btop"
          # The container runtime the private-office hub runs on. colima hosts
          # the Linux VM, docker is the client alone (the daemon lives in that
          # VM), and docker-compose is the CLI plugin the hub's `office setup`
          # drives. Verified live 2026-08-18 on formulae.brew.sh: colima 0.10.3
          # (MIT, depends on lima, which brew installs with it), docker 29.7.2
          # (Apache 2.0, "the daemon component is provided in a separate
          # formula" and is not wanted here), docker-compose 5.5.0 (Apache 2.0),
          # whose own caveat is that the CLI finds the plugin only once
          # ~/.docker/config.json names cliPluginsExtraDirs. That file is never
          # declared here: docker writes its current context into it, so a read
          # only copy would break `docker context`. The key is added instead by
          # the registerDockerCliPlugins home activation entry below, which
          # merges it in place and leaves every other key docker owns alone.
          # docker-buildx 0.36.1 (Apache 2.0, verified live 2026-08-23 on
          # formulae.brew.sh) joins them because compose refuses to build
          # without it, printing "Docker Compose requires buildx plugin to be
          # installed", which is what the private-office hub's compose build
          # hits. Its formula symlinks the plugin into that same
          # /opt/homebrew/lib/docker/cli-plugins, so the registration entry
          # below already reaches it and it needs no wiring of its own.
          "colima"
          "docker"
          "docker-buildx"
          "docker-compose"
          { name = "oven-sh/bun/bun"; trusted = true; }
        ];
        casks = [
          "font-jetbrains-mono-nerd-font"
          "raycast"
          "the-unarchiver"
          "sublime-text"
          "appcleaner"
          "1password"
          "nikitabobko/tap/aerospace"
          "scroll-reverser"
          "zoom"
          "visual-studio-code"
          "parsec"
          "ghostty"
          "altserver"
          "webcatalog"
          "notion"
          "ticktick"
          "iina"
          "transmission"
          "claude"
          "claude-code"
          "google-chrome"
          "superwhisper"
          "lzhgus/tap/capso"
          "discord"
          "calibre"
          "steam"
          "spotify"
          "fliqlo"
        ];
        masApps = {};
        onActivation.cleanup = "zap";
        onActivation.autoUpdate = true;
        onActivation.upgrade = true;
      };

      # Application symlink management
      system.activationScripts.applications.text = let
        env = pkgs.buildEnv {
          name = "system-applications";
          paths = config.environment.systemPackages;
          pathsToLink = [ "/Applications" ];
        };
      in pkgs.lib.mkForce ''
        echo "Setting up /Applications..." >&2
        rm -rf /Applications/Nix\ Apps
        mkdir -p /Applications/Nix\ Apps
        find ${env}/Applications -maxdepth 1 -type l -exec readlink '{}' + |
        while read -r src; do
          app_name=$(basename "$src")
          echo "Copying $src" >&2
          ${pkgs.mkalias}/bin/mkalias "$src" "/Applications/Nix Apps/$app_name"
        done
      '';

      # macOS system preferences configuration
      system.defaults = {
        # Dock configuration
        dock = {
          orientation = "right";
          show-recents = false;
          persistent-apps = [
            "/Applications/Ghostty.app"
            "/Applications/1Password.app"
            "/Applications/Ticktick.app"
            "/Applications/Microsoft Outlook.app"
            "/Applications/Zoom.us.app"
            "/Applications/Discord.app"
            "/Applications/Google Chrome.app"
            "/Applications/Notion.app"
            "/Applications/Visual Studio Code.app"
            "/Applications/Microsoft Excel.app"
            "/Applications/Microsoft Word.app"
            "/Applications/Microsoft PowerPoint.app"
            "/Applications/PDF Expert.app"
            "/System/Applications/App Store.app"
            "/System/Applications/System Settings.app"
            "/Applications/AppCleaner.app"
          ];
        };

        # Trackpad configuration
        trackpad = {
          Clicking = true;
          TrackpadRightClick = true;
        };

        # Login window configuration
        loginwindow = {
          GuestEnabled = false;
        };

        # Global domain preferences
        NSGlobalDomain = {
          "AppleICUForce24HourTime" = true;
          "AppleInterfaceStyle" = "Dark";
          "KeyRepeat" = 2;
          "_HIHideMenuBar" = false;
        };
      };

      # Custom user preferences (using activation script to avoid plist warnings)
      system.activationScripts.userDefaults.text = ''
        # Disable spotlight keyboard shortcuts
        /usr/bin/defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 '{ enabled = 0; }'
        /usr/bin/defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 65 '{ enabled = 0; }'
      '';

      # Set primary user for system-wide activation
      system.primaryUser = "helixw";

      # Touch ID for interactive sudo. reattach keeps it working inside tmux and
      # screen, which run outside the bootstrap session PAM ties the prompt to.
      security.pam.services.sudo_local = {
        enable = true;
        touchIdAuth = true;
        reattach = true;
      };

      # Unattended Software Update run, daily at 08:00. lockf(1) holds a kernel
      # flock for the whole run, so the interactive `dr` (which takes the same
      # file) cannot run brew at the same time; -t 0 means a collision skips this
      # run rather than queueing it, and the lock cannot go stale because the
      # kernel drops it when the holder dies.
      launchd.user.agents.morning-maintenance = {
        # `command` rather than a literal ProgramArguments: nix-darwin wraps it
        # as `/bin/sh -c "/bin/wait4path /nix/store && exec <command>"`, so a
        # fire at login cannot start before the Nix store is mounted and find
        # the script path missing.
        # -s silences lockf's own "already locked" line. It matters now that the
        # queue relaunches this job every 10 seconds through a collision (see
        # QueueDirectories below): without it, a 20 minute `dr` would write a
        # hundred error lines into the run log for a condition that is not an
        # error and resolves itself.
        command = "/usr/bin/lockf -s -t 0 -k ${maintenanceLock} /usr/bin/caffeinate -i ${morningMaintenance}";
        serviceConfig = {
          # Nothing here was asked for by the user at the keyboard, so launchd
          # throttles its CPU and I/O rather than letting it disturb the session.
          ProcessType = "Background";
          StartCalendarInterval = [ { Hour = 8; Minute = 0; } ];
          # The hub's on-demand path. A request added to this queue starts the
          # same job the schedule starts; which of the two fired is read from the
          # queue itself, so there is one script and one lock rather than a second
          # agent shadowing this one.
          #
          # QueueDirectories AND NEVER WatchPaths, which is the fix of 2026-08-24
          # and is not a preference. WatchPaths is edge-triggered on a filesystem
          # event and is documented as lossy; QueueDirectories "keeps the job
          # alive as long as the directory or directories specified are not
          # empty" (launchd.plist(5)), so it is a CONDITION rather than an event
          # and a request that lands mid-run relaunches this job once the run
          # exits. Both were measured live against the double press the user
          # actually made, 1.46 seconds apart: under WatchPaths the second
          # request was still on disk 45 seconds after the job had finished and
          # was never re-fired; under QueueDirectories it ran 2 seconds later.
          #
          # THE PRICE, stated because it is real: a lockf collision means the
          # script never runs and never drains, so this job relaunches every 10
          # seconds until `dr` lets the lock go. That is why lockf takes -s
          # above. It is the right direction, a silent retry that eventually
          # honours the press, where the old mechanism silently dropped it.
          QueueDirectories = [ maintenanceTriggerDir ];
          StandardOutPath = maintenanceLog;
          StandardErrorPath = maintenanceLog;
          # Catches up a missed 08:00 at the next login. The script's own date
          # stamp is what keeps that to one real run a day.
          RunAtLoad = true;
        };
      };

      # The hub's Shopping Research, run on demand and ONLY on demand. It is the
      # second consumer of the trigger idiom above and deliberately the plainer
      # one: no calendar entry and no RunAtLoad, because nothing here is owed on
      # a schedule and every run was pressed by a person seconds earlier.
      launchd.user.agents.shopping-research = {
        # lockf for the same reason the agent above takes one, and its scope is
        # stated rather than assumed: it serializes anything that takes THIS
        # file, which today is this job alone, launchd itself already running one
        # instance of a job at a time. What it does NOT cover is a hand-run
        # `office run shopping-enrichment` in a terminal, which takes no lock; a
        # sweep only ever writes items whose name is still null, so the cost of
        # that overlap is duplicated work on the user's own subscription rather
        # than a damaged store. -t 0 means a collision skips this launch, and -s
        # silences it: the queue below is what re-fires the job, every 10 seconds
        # until the lock frees, so the request is honoured rather than left
        # behind and the log stays free of a hundred lines saying so.
        command = "/usr/bin/lockf -s -t 0 -k ${shoppingLock} /usr/bin/caffeinate -i ${shoppingResearch}";
        serviceConfig = {
          ProcessType = "Background";
          # The whole trigger: this job runs for as long as its queue is not
          # empty, draining every request it finds and exiting when there are
          # none. QueueDirectories and never WatchPaths, for the reason the agent
          # above states in full and with the same live measurement behind it.
          QueueDirectories = [ shoppingTriggerDir ];
          StandardOutPath = shoppingLog;
          StandardErrorPath = shoppingLog;
        };
      };

      # The hub's Declare Formula, the third consumer of the trigger idiom above
      # and, like the second, on demand only.
      #
      # NO LOCK AND NO caffeinate, which is where it differs from both agents
      # above, and both omissions are reasoned rather than skipped. It takes
      # seconds, so there is no idle sleep to hold off. And the state it writes is
      # this repo's working tree, which no other job here touches, while the two
      # locks above serialize Homebrew's prefix, which this one only reads;
      # launchd already runs a single instance of a job at a time. The one
      # collision left, the user editing flake.nix by hand, is refused by the
      # script's own check on the working tree, which is the only mechanism an
      # editor would take part in.
      launchd.user.agents.declare-formula = {
        command = "${declareFormula}";
        serviceConfig = {
          ProcessType = "Background";
          QueueDirectories = [ systemTriggerDir ];
          StandardOutPath = declareFormulaLog;
          StandardErrorPath = declareFormulaLog;
        };
      };

