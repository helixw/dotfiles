              };

              # ZSH shell configuration
              programs.zsh = {
                enable = true;
                dotDir = "${config.xdg.configHome}/zsh";
                enableCompletion = true;
                autosuggestion.enable = true;
                syntaxHighlighting.enable = true;

                initContent = ''
                  # Path configuration
                  export PATH="$HOME/bin:$PATH"
                  
                  # XDG Base Directory Specification
                  export XDG_CONFIG_HOME="$HOME/.config"
                  export XDG_DATA_HOME="$HOME/.local/share"
                  export XDG_CACHE_HOME="$HOME/.cache"
                  export XDG_STATE_HOME="$HOME/.local/state"
                  
                  # History settings
                  export HISTFILE="$ZDOTDIR/.zsh_history"
                  export HISTSIZE=10000
                  export SAVEHIST=10000

                  # Useful aliases
                  alias ll="ls -lah"
                  alias claude="caffeinate -dims claude"

                  # Rebuild the system, holding the same lock the scheduled
                  # morning-maintenance agent takes, so the two never run brew
                  # against each other.
                  dr() {
                    local rc
                    # -s silences lockf, so a collision shows the message below
                    # rather than a raw "already locked" line as well.
                    /usr/bin/lockf -s -t 0 -k "${maintenanceLock}" \
                      sudo darwin-rebuild switch --flake ~/Code/dotfiles#aurelia
                    rc=$?
                    # 75 is EX_TEMPFAIL: lockf could not take the lock.
                    if [ $rc -eq 75 ]; then
                      echo "dr: morning maintenance is running; try again shortly." >&2
                    fi
                    return $rc
                  }
                  
                  # Git aliases
                  alias gs="git status"
                  alias ga="git add"
                  alias gc="git commit"
                  alias gp="git push"
                  alias gl="git pull"
                  alias gd="git diff"
                  alias gb="git branch"
                  alias gco="git checkout"
                  alias glog="git log --oneline --graph"
                  alias grb="git rebase"
                  alias grs="git reset"
                  alias gst="git stash"

                  # Font configuration
                  export FONTCONFIG_FILE="$HOME/.config/fontconfig/fonts.conf"
                  
                  # Starship prompt
                  export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
                  eval "$(starship init zsh)"
                
                  # Prefer Homebrew Python over system Python
                  export PATH="/opt/homebrew/opt/python/libexec/bin:$PATH"
                  alias python=python3
                  alias pip=pip3

                  # Vim configuration
                  export VIMINIT='source $XDG_CONFIG_HOME/vim/vimrc'

                  # n8n configuration directory
                  export N8N_USER_FOLDER="$XDG_CONFIG_HOME/n8n"

                  # Enforce recommended file permissions for n8n config
                  export N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
                '';
              };

              # Application configuration activation scripts
              home.activation = {

                # GPG directory permissions configuration
                setGpgPermissions = config.lib.dag.entryAfter [ "writeBoundary" ".gnupg/gpg-agent.conf" ] ''
                  # Set proper permissions for GPG directory
                  chmod 700 "$HOME/.gnupg"
                  find "$HOME/.gnupg" -type f -exec chmod 600 {} \;
                '';

                # GPG agent reload configuration
                reloadGpgAgent = config.lib.dag.entryAfter [ "setGpgPermissions" ] ''
                  # Restart GPG agent to apply new configuration
                  ${pkgs.gnupg}/bin/gpgconf --kill gpg-agent || true
                  ${pkgs.gnupg}/bin/gpgconf --launch gpg-agent || true
                '';

                # JetBrains Mono Nerd Font installation
                linkNerdFont = config.lib.dag.entryAfter [ "writeBoundary" ] ''
                  # Link JetBrains Mono Nerd Font to user fonts directory
                  FONT_SRC="/opt/homebrew/Caskroom/font-jetbrains-mono-nerd-font"
                  DEST="$HOME/Library/Fonts"

                  if [ -d "$FONT_SRC" ]; then
                    LATEST=$(ls -td "$FONT_SRC"/* | head -n1)
                    find "$LATEST" -iname "*JetBrainsMonoNerdFont*.ttf" -exec ln -sf {} "$DEST" \; 2>/dev/null
                  fi

                  # Refresh font cache
                  export FONTCONFIG_PATH="${pkgs.fontconfig.out}/etc/fonts"
                  export FONTCONFIG_FILE="${pkgs.fontconfig.out}/etc/fonts/fonts.conf"
                  ${pkgs.fontconfig}/bin/fc-cache -f
                '';

                # Docker CLI plugin directory registration
                registerDockerCliPlugins = config.lib.dag.entryAfter [ "writeBoundary" ] (
                  let
                    mergeScript = pkgs.writeText "register-docker-cli-plugins.py" ''
                      import json
                      import sys

                      PLUGIN_DIR = "/opt/homebrew/lib/docker/cli-plugins"

                      path = sys.argv[1]

                      with open(path) as handle:
                          text = handle.read().strip()

                      try:
                          config = json.loads(text) if text else {}
                      except ValueError as error:
                          sys.exit("docker config is not valid JSON: " + str(error))
                      if not isinstance(config, dict):
                          sys.exit("docker config root is not a JSON object")

                      dirs = config.get("cliPluginsExtraDirs")
                      if not isinstance(dirs, list):
                          dirs = []
                      if PLUGIN_DIR in dirs:
                          sys.exit(0)

                      config["cliPluginsExtraDirs"] = dirs + [PLUGIN_DIR]

                      # Truncating in place keeps the inode, owner and mode 600 that
                      # docker itself created the file with.
                      with open(path, "w") as handle:
                          json.dump(config, handle, indent="\t")
                          handle.write("\n")

                      print("registered the Homebrew docker CLI plugin directory in " + path)
                    '';
                  in
                  ''
                    # brew installs the docker-compose plugin under the Homebrew
                    # prefix, which the docker CLI searches only once
                    # ~/.docker/config.json names it in cliPluginsExtraDirs. The file
                    # stays docker owned, so this merges that one key in place and
                    # preserves every other key it carries, currentContext included;
                    # a rerun that finds the key already there writes nothing.
                    DOCKER_CONFIG_FILE="$HOME/.docker/config.json"

                    mkdir -p "$HOME/.docker"
                    if [ ! -e "$DOCKER_CONFIG_FILE" ]; then
                      (umask 077; echo '{}' > "$DOCKER_CONFIG_FILE")
                    fi

                    # Guarded so a config.json this cannot parse warns and leaves the
                    # file alone rather than failing the whole activation.
                    if ! ${pkgs.python3}/bin/python3 ${mergeScript} "$DOCKER_CONFIG_FILE"; then
                      warnEcho "docker CLI plugin directory not registered, $DOCKER_CONFIG_FILE left unchanged"
                    fi
                  ''
                );
              };
            };
          };
        }
      ];
    };
  };
}
