{
  description = "Aurelia nix-darwin system flake";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    nix-darwin.url = "github:LnL7/nix-darwin";
    nix-darwin.inputs.nixpkgs.follows = "nixpkgs";
    nix-homebrew.url = "github:zhaofengli-wip/nix-homebrew";
    # Pin Homebrew sources to the current release. The pin must stay recent:
    # the cask/formula JSON API is generated by upstream's latest brew, and
    # an older pinned brew crashes deserializing stanzas it doesn't know
    # (e.g. `depends_on :macos` in 5.1.x, `postflight_steps` in 6.0.x).
    brew-src = {
      url = "github:Homebrew/brew/6.0.11";
      flake = false;
    };
    nix-homebrew.inputs.brew-src.follows = "brew-src";
    home-manager.url = "github:nix-community/home-manager";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = inputs@{ self, nix-darwin, nixpkgs, nix-homebrew, home-manager, ... }: let
    # Paths two independent consumers must agree on: the scheduled agent and the
    # interactive `dr` take the same lock, and the agent's script and launchd's
    # own redirects write the same log. The stamp carries the date of the last
    # run start, which is what makes the catch-up fire at most once a day.
    maintenanceLock = "/Users/helixw/Library/Caches/dotfiles-system-maintenance.lock";
    maintenanceStamp = "/Users/helixw/Library/Caches/dotfiles-system-maintenance.last-run";
    maintenanceLog = "/Users/helixw/Library/Logs/morning-maintenance.log";
    # THE TRIGGER QUEUES the private-office hub asks for off-schedule runs
    # through. Each is created at activation because launchd can only watch a
    # path that exists when the job loads, and each belongs to exactly ONE
    # routine: a second routine wanting a queue gets its own directory rather
    # than sharing one, since two watchers on one directory drain each other's
    # requests.
    #
    # THE CONTRACT, stated in full at the hub's end
    # (~/Code/private-office/app/server/config.ts) and binding on both repos:
    #   - the hub adds ONE FILE PER PRESS, run-<arrival instant>-<uuid>.json,
    #     and never removes it. The NAME is the whole request, an entry
    #     appearing under its final name already, so the body is read
    #     tolerantly for the log alone. The instant is ISO 8601 with : and .
    #     written as -, so a plain `sort` on the names IS arrival order;
    #   - a watcher registers with QueueDirectories and NEVER WatchPaths, which
    #     is race-prone by its own manual page and does not replay a write
    #     landing while the job it woke is still running, and it DRAINS ITS
    #     QUEUE COMPLETELY before doing any work;
    #   - whether N drained requests are ONE run or N is the watcher's call,
    #     and the ARGUMENT decides it: a routine taking none collapses them, a
    #     routine whose request carries a value acts on every one in order.
    maintenanceTriggerDir = "/Users/helixw/.private-office/triggers";
    # The SECOND queue the rule above promised, for the hub's Shopping Research
    # routine, and its own log and lock. Same contract exactly.
    shoppingTriggerDir = "/Users/helixw/.private-office/triggers-shopping";
    shoppingLock = "/Users/helixw/Library/Caches/private-office-shopping-research.lock";
    shoppingLog = "/Users/helixw/Library/Logs/shopping-research.log";
    # THE REMAINING FOUR QUEUES, one per way the hub's System page changes what
    # this file declares, and the first whose requests CARRY A VALUE: the name a
    # person typed. That one field is what puts these watchers on the other side
    # of the collapse rule above. Each acts on EVERY drained request and never on
    # just the last, because two presses are two different names, and takes them
    # IN ARRIVAL ORDER by sorting the listing, which the hub spells its filenames
    # to make sufficient.
    #
    # ONE QUEUE PER OPERATION rather than one queue carrying a verb in the body:
    # a watcher must know what it is being asked to do from the entry it can see
    # the instant it appears, and a body-borne verb is the one part of the
    # document it cannot trust then. None of these EVER activates: declaring
    # puts a name in a list and undeclaring takes it out, while installing and
    # uninstalling are `darwin-rebuild`, which stays the user's own hand.
    systemTriggerDir = "/Users/helixw/.private-office/triggers-system";
    systemCaskTriggerDir = "/Users/helixw/.private-office/triggers-system-cask";
    systemRemovalTriggerDir = "/Users/helixw/.private-office/triggers-system-removal";
    systemCaskRemovalTriggerDir = "/Users/helixw/.private-office/triggers-system-cask-removal";
    declareFormulaLog = "/Users/helixw/Library/Logs/declare-formula.log";
    declareCaskLog = "/Users/helixw/Library/Logs/declare-cask.log";
    undeclareFormulaLog = "/Users/helixw/Library/Logs/undeclare-formula.log";
    undeclareCaskLog = "/Users/helixw/Library/Logs/undeclare-cask.log";
    # WHAT THE HUB READS THIS LIST FROM, and the one thing this machine publishes
    # for it. The authoritative answer is `nix eval` against this flake, which
    # needs the /nix store and this checkout; the hub has neither where it serves
    # (its own app/server/config.ts states that at SYSTEM_BREWS), so the answer is
    # published as one JSON document into the artifacts directory it already binds
    # read only. Every write of it goes through publishBrews below.
    brewsArtifact = "/Users/helixw/.private-office/artifacts/system/brews.json";
    # THE OTHER HALF OF THAT REPORT, and the only way a REFUSAL can reach the
    # user's screen at all. A change that fails leaves the queue empty and the
    # published list unchanged, which is exactly what a press the watcher has not
    # reached yet looks like, so until these documents existed the hub's row went
    # quietly back to "No Run Yet" and the reason lived only in the log and in one
    # notification. Each is written on a refusal and removed the moment its own
    # watcher has fresh work to report on, so its presence IS the report.
    #
    # ONE PER QUEUE, so a formula refusal cannot overwrite a cask refusal a
    # second later and leave the row nobody would think to look for. The hub
    # turns the `reason` word into a sentence, so this file writes reason tokens
    # from that vocabulary and never prose for a surface it cannot see.
    declareFormulaFailureArtifact = "/Users/helixw/.private-office/artifacts/system/declare-formula-failure.json";
    declareCaskFailureArtifact = "/Users/helixw/.private-office/artifacts/system/declare-cask-failure.json";
    removeFormulaFailureArtifact = "/Users/helixw/.private-office/artifacts/system/remove-formula-failure.json";
    removeCaskFailureArtifact = "/Users/helixw/.private-office/artifacts/system/remove-cask-failure.json";
    # This repo, addressed absolutely rather than as a working directory: a
    # launchd job starts in / and has no notion of where its own source lives.
    dotfilesDir = "/Users/helixw/Code/dotfiles";
    # The one host this flake configures, spelled once: the configuration below is
    # named with it, and the two scripts evaluate that configuration by name.
    darwinHost = "aurelia";

    configuration = { pkgs, config, ... }: let
      # Unattended Software Update run. Runs as the login user: no root, no
      # secrets, and macOS updates are listed only, never installed. Casks whose
      # artifacts carry a pkg stanza run an installer that asks for sudo, which
      # there is no tty to answer, so the outdated list is filtered against
      # brew's own metadata at run time and those are left to the interactive
      # run.
      morningMaintenance = pkgs.writeShellScript "morning-maintenance" ''
        set -u

        BREW=/opt/homebrew/bin/brew
        LOG="${maintenanceLog}"
        STAMP="${maintenanceStamp}"
        TRIGGERS="${maintenanceTriggerDir}"
        TODAY=$(date '+%Y-%m-%d')

        export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
        export HOMEBREW_NO_ENV_HINTS=1

        log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

        # Two ways in, one script. A SCHEDULED run (08:00, or the catch-up at
        # load) dedupes on the date stamp below and is unchanged. A REQUESTED
        # run, which the private-office hub asks for by adding run-<uuid>.json to
        # $TRIGGERS, bypasses that stamp for that run alone. The queue is drained
        # BEFORE any work, so a run that dies midway cannot re-fire forever.
        #
        # EVERY ENTRY IS DELETED, recognised or not: QueueDirectories keeps this
        # job alive while the directory is non-empty, so one file left behind
        # relaunches it every ThrottleInterval forever. What is deleted is
        # exactly what was LISTED, which is why the listing goes to a file
        # first: a press landing between the list and the rm would otherwise be
        # deleted without ever being run.
        force=0
        drained=$(mktemp -t private-office-maintenance-drain)
        find "$TRIGGERS" -mindepth 1 -maxdepth 1 > "$drained" 2>/dev/null || true
        requests=$(grep -c '/run-[^/]*\.json$' "$drained" || true)
        while IFS= read -r entry; do
          case "$entry" in
            */run-*.json)
              requested_at=$(jq -r '.requested_at // "unknown"' < "$entry" 2>/dev/null || echo unknown)
              log "request drained ($(basename "$entry"), requested_at $requested_at)"
              ;;
            *)
              log "unrecognised entry drained from $TRIGGERS: $(basename "$entry")"
              ;;
          esac
          rm -rf -- "$entry"
        done < "$drained"
        rm -f "$drained"
        if [ "$requests" -gt 0 ]; then
          force=1
          log "$requests request(s) drained; running now and skipping the day stamp"
        fi

        # The agent also runs at load, so a Mac that was asleep at 08:00 catches
        # up at the next login. A day already covered exits here, which keeps
        # every later login of that day silent apart from this one line.
        if [ "$force" -eq 0 ] && [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$TODAY" ]; then
          log "already ran today; skipping"
          exit 0
        fi

        # Stamped at the start, not the end, so a run that dies midway still
        # counts as today's attempt rather than re-firing at every login.
        mkdir -p "$(dirname "$STAMP")"
        printf '%s\n' "$TODAY" > "$STAMP"

        # Trim in place so launchd's append handle keeps pointing at this inode.
        if [ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 5000 ]; then
          tail -n 2000 "$LOG" > "$LOG.trim" && cat "$LOG.trim" > "$LOG"
          rm -f "$LOG.trim"
        fi

        failed=""

        log "brew update"
        # Metadata is fresh only when the update succeeded, so the suppression
        # is set on that branch alone and a failed update leaves brew free to
        # auto-update itself on the commands that follow.
        if "$BREW" update; then
          export HOMEBREW_NO_AUTO_UPDATE=1
        else
          failed="''${failed:+$failed, }brew-update"
        fi

        # --yes because ask mode is brew's default and would hang unattended.
        log "brew upgrade (formulae)"
        "$BREW" upgrade --formula --yes || failed="''${failed:+$failed, }brew-upgrade-formula"

        log "brew upgrade (casks, excluding pkg installers)"
        # A bare --cask with no names upgrades every cask, so a token list
        # reaches brew only when it is known to be non-empty.
        outdated=$("$BREW" outdated --cask --quiet || true)
        if [ -z "$outdated" ]; then
          log "no casks to upgrade"
        else
          # Which casks need sudo is read from brew's own metadata rather than
          # named here, so a cask that gains or drops a pkg installer upstream
          # is handled without an edit.
          # Intentional word splitting: one cask token per line.
          # shellcheck disable=SC2086
          cask_json=$("$BREW" info --json=v2 --cask $outdated)
          info_rc=$?
          pkg_casks=$(printf '%s' "$cask_json" | jq -r '.casks[] | select([.artifacts[]? | objects | has("pkg")] | any) | .token')
          jq_rc=$?

          if [ "$info_rc" -ne 0 ] || [ "$jq_rc" -ne 0 ]; then
            # jq reports an empty selection and a missing document the same way,
            # so without a clean read a pkg cask could reach brew and stall on a
            # sudo prompt that has no tty. The phase is skipped instead.
            log "cask metadata unavailable; skipping cask upgrades"
            failed="''${failed:+$failed, }brew-cask-metadata"
          else
            if [ -n "$pkg_casks" ]; then
              log "leaving pkg-installer casks to the interactive run: $(printf '%s' "$pkg_casks" | tr '\n' ' ')"
              casks=$(printf '%s\n' "$outdated" | grep -vxF "$pkg_casks" || true)
            else
              casks="$outdated"
            fi

            if [ -z "$casks" ]; then
              log "no casks to upgrade"
            else
              # Intentional word splitting: one cask token per line.
              # shellcheck disable=SC2086
              "$BREW" upgrade --cask --yes $casks || failed="''${failed:+$failed, }brew-upgrade-cask"
            fi
          fi
        fi

        # Linkage verification, repaired in the same run. It reads Mach-O load
        # commands and executes nothing: `brew missing` does not see this class
        # and `brew linkage` switches Homebrew's developer mode on to run.
        # References under /usr/lib are skipped, living in the dyld shared cache
        # with no file on disk to test, and symlinked entries are skipped
        # because the real file is scanned under its own formula's name.
        #
        # The sed pattern requires AT LEAST ONE leading whitespace character.
        # otool -L opens with the scanned file's own path at column zero and
        # indents only the dependency lines below it, so a pattern accepting
        # zero leading whitespace reads that header as a dependency, keeps the
        # trailing colon inside the path token, and makes every scanned formula
        # flag itself against its own binary with no reinstall able to clear it.
        broken_formulae() {
          for bf_name in "$@"; do
            bf_prefix=$("$BREW" --prefix --installed "$bf_name" 2>/dev/null) || continue
            [ -n "$bf_prefix" ] || continue
            find -H "$bf_prefix/bin" "$bf_prefix/sbin" "$bf_prefix/lib" \
              -maxdepth 2 -type f -print 2>/dev/null |
            while read -r bf_file; do
              /usr/bin/otool -L "$bf_file" 2>/dev/null |
                sed -n 's|^[[:space:]][[:space:]]*\(/opt/homebrew/[^[:space:]]*\).*|\1|p' |
                while read -r bf_target; do
                  if [ ! -e "$bf_target" ]; then
                    printf '%s\n' "$bf_name"
                  fi
                done
            done
          done | sort -u
        }

        # EVERY RUN, AND NEVER ONLY A RUN THAT UPGRADED SOMETHING. Scoping this
        # to the formulae that just moved made a quiet day look like a clean
        # machine: a break survives every later run until something upgrades
        # again, and it is a run that upgrades nothing that a person is least
        # likely to go and read. The candidate set is therefore every installed
        # formula, which subsumes the upgraded ones and their dependents. It
        # reads Mach-O headers and executes nothing, so the cost is time alone:
        # 72 seconds over 92 formulae, measured 2026-08-24 on this machine.
        log "verifying linkage across every installed formula"
        if ! installed_formulae=$("$BREW" list --formula); then
          # An unreadable list and a machine with nothing installed reach this
          # scan looking identical, so a failed read is reported rather than
          # passing as a verification that found nothing wrong.
          log "the installed formulae could not be listed; linkage was not verified"
          failed="''${failed:+$failed, }brew-linkage-unverified"
        elif [ -z "$installed_formulae" ]; then
          log "no installed formulae to verify"
        else
          # Intentional word splitting: one formula token per line.
          # shellcheck disable=SC2086
          broken=$(broken_formulae $installed_formulae)

          if [ -z "$broken" ]; then
            log "linkage clean across $(printf '%s\n' "$installed_formulae" | wc -l | tr -d ' ') formulae"
          else
            log "orphaned linkage: $(printf '%s' "$broken" | tr '\n' ' ')"
            # Only the orphaned formula is touched. Repouring it relinks it
            # against the prefix as it now stands, which is what the upgrade
            # ordering left stale; a bare `brew upgrade` of everything would be
            # a second, unscoped upgrade phase and is never run here.
            for bf in $broken; do
              log "repairing $bf (brew reinstall)"
              "$BREW" reinstall --formula "$bf" || log "reinstall of $bf failed"
            done

            # Intentional word splitting: one formula token per line.
            # shellcheck disable=SC2086
            still_broken=$(broken_formulae $broken)
            if [ -n "$still_broken" ]; then
              # Repouring cannot fix a formula whose published bottle is itself
              # built against a version that is gone; that needs the user.
              log "STILL BROKEN after repair: $(printf '%s' "$still_broken" | tr '\n' ' ')"
              failed="''${failed:+$failed, }brew-linkage-unrepaired"
            else
              log "repaired: $(printf '%s' "$broken" | tr '\n' ' ')"
              /usr/bin/osascript -e "display notification \"Repaired: $(printf '%s' "$broken" | tr '\n' ' ')\" with title \"Software Update\"" || true
            fi
          fi
        fi

        log "brew cleanup"
        "$BREW" cleanup || failed="''${failed:+$failed, }brew-cleanup"

        # Report only. Installing macOS updates needs root and stays manual.
        log "softwareupdate --list"
        /usr/sbin/softwareupdate --list || failed="''${failed:+$failed, }softwareupdate-list"

        # The hub's copy of the declared formulae, refreshed on the daily run so
        # that a formula added to this file BY HAND reaches the page too, and not
        # only one added through the watcher below, which republishes for itself.
        #
        # IT DOES NOT JOIN "$failed", which is deliberate and not an oversight.
        # That list is a VOCABULARY THE HUB RENDERS, each token mapped to a
        # sentence in its own maintenance module, so a token invented here would
        # reach the user as a raw word. And what this failing costs is the
        # PREVIOUS list, which was true when it was written, rather than a wrong
        # one; the next declare or the next morning replaces it.
        log "publishing the declared formulae for the hub"
        ${publishBrews} || log "the declared formulae could not be republished"

        if [ -n "$failed" ]; then
          log "FAILED: $failed"
          /usr/bin/osascript -e "display notification \"Failed: $failed\" with title \"Software Update\"" || true
          exit 1
        fi

        log "done"
      '';

      # The private-office hub's Shopping Research routine, run HERE because the
      # hub serves from a container and the `claude` CLI it spawns, with the
      # user's subscription credentials, is on this machine.
      shoppingResearch = pkgs.writeShellScript "shopping-research" ''
        set -u

        BUN=/opt/homebrew/bin/bun
        APP=/Users/helixw/Code/private-office/app
        TRIGGERS="${shoppingTriggerDir}"
        LOG="${shoppingLog}"

        # PATH resolves bun and claude; HOME and USER are exported rather than
        # inherited because the routine passes exactly these three on to the
        # `claude` child (that repo's enrich.ts states the measurement, USER
        # being what reaches the subscription), and a launchd job is not a login
        # shell.
        export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
        export HOME=/Users/helixw
        export USER=helixw

        log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

        # NO SCHEDULE AND NO CATCH-UP, which is the one place this differs from
        # the Software Update agent above: every run here was asked for by a
        # person a moment ago, so there is no dedupe stamp to keep and nothing to
        # catch up on. The job launches on its queue being non-empty alone, and a
        # request added while this agent was not loaded is picked up the moment it
        # loads, the queue still holding it.
        drained=$(mktemp -t private-office-shopping-drain)
        find "$TRIGGERS" -mindepth 1 -maxdepth 1 > "$drained" 2>/dev/null || true
        requests=$(grep -c '/run-[^/]*\.json$' "$drained" || true)
        while IFS= read -r entry; do
          case "$entry" in
            */run-*.json)
              requested_at=$(jq -r '.requested_at // "unknown"' < "$entry" 2>/dev/null || echo unknown)
              log "request drained ($(basename "$entry"), requested_at $requested_at)"
              ;;
            *)
              log "unrecognised entry drained from $TRIGGERS: $(basename "$entry")"
              ;;
          esac
          rm -rf -- "$entry"
        done < "$drained"
        rm -f "$drained"

        # A launch with nothing to run is ordinary rather than exceptional: it is
        # what the relaunch after a drain always finds, and what an unrecognised
        # file alone would produce. Nothing here has a schedule, so no request
        # means no work.
        if [ "$requests" -eq 0 ]; then
          log "no request in the queue; nothing to do"
          exit 0
        fi

        log "$requests request(s) drained; running Shopping Research"
        if "$BUN" run --cwd "$APP" office run shopping-enrichment; then
          log "done"
        else
          rc=$?
          # The hub cannot report this. Its status row reads the run state of its
          # OWN process, and this run is not in it, so a failure here is visible
          # nowhere on screen unless it is said out loud.
          log "FAILED (exit $rc)"
          /usr/bin/osascript -e "display notification \"The run failed (exit $rc); see $LOG\" with title \"Shopping Research\"" || true
          exit 1
        fi
      '';

      # PUBLISHING WHAT THIS FLAKE DECLARES, formulae AND casks, so the hub can
      # show it. Two callers run it: the Declare Formula watcher below
      # republishes after every formula it adds, a list still missing what the
      # user just asked for reading exactly like a press that did nothing; and
      # the Software Update run republishes daily, so an item added by hand in an
      # editor reaches the page as well.
      publishBrews = pkgs.writeShellScript "publish-brews" ''
        set -u

        NIX=/nix/var/nix/profiles/default/bin/nix
        BREW=/opt/homebrew/bin/brew
        OUT="${brewsArtifact}"
        HOMEBREW_ATTR="${dotfilesDir}#darwinConfigurations.${darwinHost}.config.homebrew"

        export HOMEBREW_NO_AUTO_UPDATE=1
        export HOMEBREW_NO_ANALYTICS=1
        export HOMEBREW_NO_ENV_HINTS=1

        mkdir -p "$(dirname "$OUT")" || exit 1
        pb_work=$(mktemp -d -t publish-brews) || exit 1
        trap 'rm -rf "$pb_work"' EXIT

        "$NIX" eval "$HOMEBREW_ATTR.brews" --json > "$pb_work/formulae.json" || exit 1
        "$NIX" eval "$HOMEBREW_ATTR.casks" --json > "$pb_work/casks.json" || exit 1

        # An empty map is what every failure path below leaves in place, and the
        # assembly reads a name missing from it as a missing description.
        printf '{}' > "$pb_work/formula-desc.json"
        printf '{}' > "$pb_work/cask-desc.json"

        pb_names=$(jq -r '.[].name' < "$pb_work/formulae.json")
        if [ -n "$pb_names" ]; then
          # Intentional word splitting: one formula name per line.
          # shellcheck disable=SC2086
          if pb_json=$("$BREW" info --formula --json=v2 $pb_names 2>/dev/null); then
            printf '%s' "$pb_json" |
              jq '[.formulae[] | . as $f | [$f.full_name] + ($f.aliases // []) |
                   .[] | {key: ., value: ($f.desc // "")}] | from_entries' \
              > "$pb_work/formula-desc.json" ||
              printf '{}' > "$pb_work/formula-desc.json"
          fi
        fi

        pb_tokens=$(jq -r '.[].name' < "$pb_work/casks.json")
        if [ -n "$pb_tokens" ]; then
          # Intentional word splitting: one cask token per line.
          # shellcheck disable=SC2086
          if pb_json=$("$BREW" info --cask --json=v2 $pb_tokens 2>/dev/null); then
            printf '%s' "$pb_json" |
              jq '[.casks[] | {key: .full_token, value: (.desc // "")}] | from_entries' \
              > "$pb_work/cask-desc.json" ||
              printf '{}' > "$pb_work/cask-desc.json"
          fi
        fi

        pb_tmp=$(mktemp "$OUT.XXXXXX") || exit 1
        if jq -n \
          --slurpfile formulae "$pb_work/formulae.json" \
          --slurpfile casks "$pb_work/casks.json" \
          --slurpfile formula_desc "$pb_work/formula-desc.json" \
          --slurpfile cask_desc "$pb_work/cask-desc.json" \
          '{
             formulae: [$formulae[0][] | . + {description: ($formula_desc[0][.name] // "")}],
             casks: [$casks[0][] | {name, description: ($cask_desc[0][.name] // "")}]
           }' > "$pb_tmp"; then
          # The mode mktemp gives is the one the temporary file needed, not the
          # one a published document wants; the hub reads this through a bind
          # mount and every other artifact under there is world readable.
          chmod 644 "$pb_tmp"
          mv -f "$pb_tmp" "$OUT"
          exit 0
        fi
        rm -f "$pb_tmp"
        exit 1
      '';

      # THE HUB'S FOUR SOFTWARE ROUTINES, one launchd watcher each, generated
      # from ONE body. They run here because the work IS an edit to this file: it
      # needs nix, brew, git and this checkout, and the hub's container has none
      # of them.
      #
      # A REMOVAL DOES NOT ASK HOMEBREW ANYTHING AT ALL. What can be undeclared
      # is what this file declares, so the declared list is the only authority a
      # removal needs, and an item Homebrew has since renamed or dropped must
      # still be removable.
      softwareWatcher =
        { operation, title, kind, action, triggerDir, failureArtifact, watcherLog }:
        let
          isFormula = kind == "formula";
          declaring = action == "declare";
          # The attribute this kind is declared under, which is also the list
          # marker both awk edits below anchor on.
          listAttr = if isFormula then "brews" else "casks";
          # Homebrew addresses the two kinds with a different flag, answers under
          # a different array, and carries the fully qualified name under a
          # different key.
          infoFlag = if isFormula then "--formula" else "--cask";
          infoArray = if isFormula then "formulae" else "casks";
          qualifiedKey = if isFormula then "full_name" else "full_token";
          # The tap an unqualified name resolves to. An item from it is the one
          # case written into this file exactly as the user typed it.
          coreTap = if isFormula then "homebrew/core" else "homebrew/cask";
          verb = if declaring then "declare" else "undeclare";
          # Casks are named in a commit subject; formulae are the unmarked case,
          # which is the form every existing declare commit here carries.
          commitNoun = if isFormula then "" else "cask ";

          commonHead = ''
            set -u

            NIX=/nix/var/nix/profiles/default/bin/nix
            GIT=/usr/bin/git
            DOTFILES="${dotfilesDir}"
            FLAKE="${dotfilesDir}/flake.nix"
            HOMEBREW_ATTR="${dotfilesDir}#darwinConfigurations.${darwinHost}.config.homebrew"
            TRIGGERS="${triggerDir}"
            LOG="${watcherLog}"
            FAILURE="${failureArtifact}"

            # PATH resolves brew and jq; HOME is what git reads the user's
            # identity through and what nix finds its own configuration under,
            # and a launchd job is not a login shell.
            export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
            export HOME=/Users/helixw
            export USER=helixw
            export HOMEBREW_NO_AUTO_UPDATE=1
            export HOMEBREW_NO_ANALYTICS=1
            export HOMEBREW_NO_ENV_HINTS=1

            log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }
            notify() {
              /usr/bin/osascript -e "display notification \"$1\" with title \"${title}\"" || true
            }

            # PUBLISHING A REFUSAL so the hub's own row can show it, which is the
            # only surface the user is actually looking at when they press Run.
            record_failure() {
              mkdir -p "$(dirname "$FAILURE")" || return 0
              rf_tmp=$(mktemp "$FAILURE.XXXXXX") || return 0
              if jq -n \
                --arg failed_at "$(date '+%Y-%m-%d %H:%M:%S')" \
                --arg operation "${operation}" \
                --arg name "$1" \
                --arg reason "$2" \
                '{failed_at: $failed_at, operation: $operation, name: $name, reason: $reason}' > "$rf_tmp"; then
                chmod 644 "$rf_tmp"
                mv -f "$rf_tmp" "$FAILURE"
                return 0
              fi
              rm -f "$rf_tmp"
            }

            # ONE REQUEST REFUSED: said in the log in this script's words and in
            # the document in the hub's token. They are deliberately the same
            # call, so a refusal cannot be logged and left unpublished. Called
            # only from handle_request, where sw_typed is the request in hand.
            refuse() {
              log "FAILED $sw_typed: $2"
              record_failure "$sw_typed" "$1"
            }

            # COMMITTING ONE EDIT, path limited to this file, and republishing
            # the list the hub reads. Republished per request rather than once at
            # the end, so a run handling three names shows each one as it lands.
            commit_edit() {
              ce_message=$(mktemp -t private-office-${operation}-message) || return 1
              printf '%s\n' "$1" > "$ce_message"
              if ! "$GIT" -C "$DOTFILES" commit -q -F "$ce_message" -- flake.nix; then
                rm -f "$ce_message"
                refuse commit-refused "the commit was refused, so the edit was reverted"
                "$GIT" -C "$DOTFILES" checkout -- flake.nix
                return 1
              fi
              rm -f "$ce_message"

              if ! ${publishBrews}; then
                refuse publish-refused "the change was committed, but the list the hub reads could not be republished"
                return 1
              fi
              return 0
            }

            # Every item this flake declares of this kind, under the name nix
            # resolves it to, which is what makes one read cover every
            # declaration form.
            declared_names() {
              "$NIX" eval "$HOMEBREW_ATTR.${listAttr}" --json | jq -r '.[].name'
            }

            # THE DRAIN, which is the contract's and is stated in full at the
            # first agent above: every entry goes, recognised or not, because
            # QueueDirectories relaunches this job every 10 seconds for as long
            # as anything is left; and exactly what was LISTED is what is
            # deleted, so a press landing mid drain survives to earn its own
            # relaunch.
            drained=$(mktemp -t private-office-${operation}-drain)
            requested=$(mktemp -t private-office-${operation}-requests)
            find "$TRIGGERS" -mindepth 1 -maxdepth 1 2>/dev/null | LC_ALL=C sort > "$drained" || true
            while IFS= read -r entry; do
              case "$entry" in
                */run-*.json)
                  requested_at=$(jq -r '.requested_at // "unknown"' < "$entry" 2>/dev/null || echo unknown)
                  typed=$(jq -r '.argument // empty' < "$entry" 2>/dev/null || true)
                  log "request drained ($(basename "$entry"), requested_at $requested_at, ${kind} ''${typed:-none})"
                  if [ -n "$typed" ]; then
                    printf '%s\n' "$typed" >> "$requested"
                  else
                    log "that request carried no ${kind} name, so there is nothing to ${verb}"
                  fi
                  ;;
                *)
                  log "unrecognised entry drained from $TRIGGERS: $(basename "$entry")"
                  ;;
              esac
              rm -rf -- "$entry"
            done < "$drained"
            rm -f "$drained"

            # A launch with nothing to run is ordinary rather than exceptional:
            # it is what the relaunch after a drain always finds. Nothing here
            # has a schedule, so no request means no work.
            if [ ! -s "$requested" ]; then
              log "no ${kind} in the queue; nothing to do"
              rm -f "$requested"
              exit 0
            fi

            # THIS RUN SUPERSEDES THE LAST REPORT, so the previous refusal goes
            # now that there is fresh work to report on. A SUCCESS therefore
            # clears the document by leaving it cleared.
            rm -f "$FAILURE"

            # THE USER'S OWN EDIT COMES FIRST. A commit here is limited to
            # flake.nix, so an unrelated file in flight is safe either way, but
            # an unfinished edit to THIS file would be committed under a message
            # about one name. Checked once for the whole run rather than per
            # request, since the answer cannot change while this job holds the
            # only other pen.
            if ! "$GIT" -C "$DOTFILES" diff --quiet -- flake.nix ||
               ! "$GIT" -C "$DOTFILES" diff --cached --quiet -- flake.nix; then
              log "FAILED: flake.nix carries uncommitted changes, so nothing was ${verb}d"
              notify "flake.nix has uncommitted changes, so nothing was ${verb}d"
              # Reported against the LAST name queued, which is the one the
              # person who is about to look at the page just typed. Every request
              # in this run was refused for the one reason, the log lists them
              # all, and a row can only carry one.
              record_failure "$(tail -n 1 "$requested")" flake-dirty
              rm -f "$requested"
              exit 1
            fi
          '';

          declareBody = ''

            # Only the declaring half ever asks Homebrew anything, so this is not
            # in the shared part above.
            BREW=/opt/homebrew/bin/brew

            # A tap as Homebrew addresses it: a repository named homebrew-tap is
            # the tap called plain tap, and case never matters.
            normalise_tap() {
              printf '%s\n' "$1" | sed 's|/homebrew-|/|' | tr '[:upper:]' '[:lower:]'
            }

            # The taps trusted at the top of the homebrew block, whose items need
            # nothing of their own beyond a qualified name.
            declared_taps() {
              "$NIX" eval "$HOMEBREW_ATTR.taps" --json |
                jq -r '.[] | select(.trusted) | .name' | sed 's|/homebrew-|/|'
            }

            # Every tap this flake trusts by any route, the block above plus any
            # entry in this kind's own list carrying the flag itself, which is
            # how oven-sh/bun/bun is written.
            trusted_taps() {
              declared_taps
              "$NIX" eval "$HOMEBREW_ATTR.${listAttr}" --json |
                jq -r '.[] | select(.trusted) | .name | split("/") | select(length == 3) | .[0:2] | join("/")' |
                sed 's|/homebrew-|/|'
            }

            # ADDING ONE ENTRY, at the END of the list and never in sorted
            # position: that list is grouped by purpose with a comment over each
            # group, so an alphabetical insertion would split a group and orphan
            # its comment. The closing bracket is FOUND rather than remembered,
            # by matching the line that opens the list and then the first line at
            # the same indentation that closes it, so neither a line number nor
            # an edit elsewhere in the file can send this to the wrong place.
            insert_entry() {
              ie_tmp=$(mktemp -t private-office-${operation}-flake) || return 1
              if awk -v entry="$1" '
                state == 0 && $0 ~ /^[[:space:]]*${listAttr}[[:space:]]*=[[:space:]]*\[[[:space:]]*$/ {
                  match($0, /^[[:space:]]*/)
                  indent = substr($0, 1, RLENGTH)
                  closing = indent "];"
                  state = 1
                  print
                  next
                }
                state == 1 && $0 == closing { print indent "  " entry; state = 2 }
                { print }
                END { exit(state == 2 ? 0 : 1) }
              ' "$FLAKE" > "$ie_tmp"; then
                # Written back through the same inode, so the file keeps its mode.
                cat "$ie_tmp" > "$FLAKE"
                rm -f "$ie_tmp"
                return 0
              fi
              rm -f "$ie_tmp"
              return 1
            }

            # ONE REQUEST, START TO FINISH. 0 means the item is declared, whether
            # this run is what declared it or it was already there; 1 means it is
            # not, and the log line above the return says why in the reader's
            # words.
            handle_request() {
              sw_typed="$1"

              # WHERE THE NAME COMES FROM decides how far this can go before
              # touching anything. A tap qualified name addresses a third party,
              # and the tap is checked HERE, before brew is called at all: `brew
              # info` on a tap this machine has never seen would clone it, which
              # is the very trust decision this must not make on the user's
              # behalf.
              # The arms are ordered from the longest shape down, which is how a
              # case picks the right one: a name is bare or exactly the three
              # segments of user/repo/name, and anything else is neither.
              case "$sw_typed" in
                */*/*/*)
                  refuse not-a-${kind}-name "that is not a ${kind} name"
                  return 1
                  ;;
                */*/*)
                  sw_tap=$(normalise_tap "$(dirname "$sw_typed")")
                  if ! trusted_taps | grep -qxF "$sw_tap"; then
                    refuse untrusted-tap "this flake does not trust the tap $sw_tap, so nothing was declared"
                    return 1
                  fi
                  ;;
                */*)
                  refuse not-a-${kind}-name "that is not a ${kind} name"
                  return 1
                  ;;
              esac

              if ! sw_json=$("$BREW" info ${infoFlag} "$sw_typed" --json=v2 2>/dev/null); then
                refuse no-such-${kind} "Homebrew has no ${kind} by that name"
                return 1
              fi
              sw_qualified=$(printf '%s' "$sw_json" | jq -r '.${infoArray}[0].${qualifiedKey} // empty')
              sw_tapname=$(printf '%s' "$sw_json" | jq -r '.${infoArray}[0].tap // empty')
              sw_aliases=$(printf '%s' "$sw_json" | jq -r '.${infoArray}[0].aliases[]?')
              if [ -z "$sw_qualified" ] || [ -z "$sw_tapname" ]; then
                refuse unreadable-brew-answer "Homebrew answered nothing this could read"
                return 1
              fi

              # HOW IT WILL BE WRITTEN, in whichever of the forms this file
              # already uses, and the last place an item can still be refused.
              if [ "$sw_tapname" = "${coreTap}" ]; then
                # The name as typed, which is what the user would have written
                # here by hand and the form every core entry above carries.
                sw_name="$sw_typed"
                sw_entry="\"$sw_typed\""
              else
                sw_tap=$(normalise_tap "$sw_tapname")
                sw_name="$sw_qualified"
                if declared_taps | grep -qxF "$sw_tap"; then
                  sw_entry="\"$sw_qualified\""
                elif trusted_taps | grep -qxF "$sw_tap"; then
                  # Trusted only through an entry of its own, so a sibling from
                  # that tap carries the flag the same way bun does.
                  sw_entry="{ name = \"$sw_qualified\"; trusted = true; }"
                else
                  refuse untrusted-tap "this flake does not trust the tap $sw_tap, so nothing was declared"
                  return 1
                fi
              fi

              # THE NAME TYPED IS NOT THE ONLY NAME IT HAS, which is why the
              # check is against every name Homebrew knows rather than the one
              # word that arrived: `python` is an ALIAS of python@3.14 and this
              # list declares the alias, so a check on the typed word alone would
              # declare a second entry for an item that is already there.
              if ! sw_declared=$(declared_names); then
                refuse unreadable-declarations "the declared ${listAttr} could not be read"
                return 1
              fi
              # Intentional word splitting: one alias per line.
              # shellcheck disable=SC2086
              for sw_known in "$sw_typed" "$sw_qualified" $sw_aliases; do
                if printf '%s\n' "$sw_declared" | grep -qxF "$sw_known"; then
                  log "$sw_typed is already declared (as $sw_known); nothing to add"
                  return 0
                fi
              done

              if ! insert_entry "$sw_entry"; then
                refuse insert-refused "it could not be added to the ${listAttr} list"
                return 1
              fi

              # THE EDIT PROVES ITSELF BEFORE IT IS COMMITTED. The flake must
              # still evaluate AND must evaluate with this item in it, which is
              # one read answering both questions. A file that fails it is
              # restored, because a flake.nix that does not evaluate is a machine
              # that cannot be activated at all and no one request is worth that.
              if ! declared_names | grep -qxF "$sw_name"; then
                refuse flake-would-not-evaluate "the flake did not evaluate with it, so the edit was reverted"
                "$GIT" -C "$DOTFILES" checkout -- flake.nix
                return 1
              fi

              commit_edit "feat(homebrew): declare ${commitNoun}$sw_name" || return 1

              log "declared $sw_name"
              return 0
            }
          '';

          removeBody = ''

            # REMOVING ONE ENTRY, the counterpart to insert_entry and anchored
            # the same way: the line that opens the list, then the first line
            # inside it that declares this name.
            remove_entry() {
              re_tmp=$(mktemp -t private-office-${operation}-flake) || return 1
              if awk -v target="$1" '
                inlist == 0 && $0 ~ /^[[:space:]]*${listAttr}[[:space:]]*=[[:space:]]*\[[[:space:]]*$/ {
                  match($0, /^[[:space:]]*/)
                  indent = substr($0, 1, RLENGTH)
                  closing = indent "];"
                  inlist = 1
                  print
                  next
                }
                inlist == 1 && $0 == closing { inlist = 2 }
                inlist == 1 && found == 0 {
                  line = $0
                  sub(/^[[:space:]]+/, "", line)
                  sub(/[[:space:]]+$/, "", line)
                  if (substr(line, 1, 1) != "#" &&
                      (line == "\"" target "\"" ||
                       index(line, "name = \"" target "\"") > 0)) {
                    found = 1
                    next
                  }
                }
                { print }
                END { exit(found == 1 ? 0 : 1) }
              ' "$FLAKE" > "$re_tmp"; then
                # Written back through the same inode, so the file keeps its mode.
                cat "$re_tmp" > "$FLAKE"
                rm -f "$re_tmp"
                return 0
              fi
              rm -f "$re_tmp"
              return 1
            }

            # ONE REQUEST, START TO FINISH. 0 means the list no longer carries
            # the name; 1 means it still does.
            handle_request() {
              sw_typed="$1"

              if ! sw_declared=$(declared_names); then
                refuse unreadable-declarations "the declared ${listAttr} could not be read"
                return 1
              fi
              if ! printf '%s\n' "$sw_declared" | grep -qxF "$sw_typed"; then
                refuse not-declared "this flake does not declare $sw_typed, so there was nothing to remove"
                return 1
              fi

              if ! remove_entry "$sw_typed"; then
                refuse remove-refused "it could not be removed from the ${listAttr} list"
                return 1
              fi

              # THE EDIT PROVES ITSELF BEFORE IT IS COMMITTED, the same read the
              # declaring half does and for the same reason: the flake must still
              # evaluate, and it must now evaluate WITHOUT this name.
              if ! sw_after=$(declared_names); then
                refuse flake-would-not-evaluate "the flake did not evaluate without it, so the edit was reverted"
                "$GIT" -C "$DOTFILES" checkout -- flake.nix
                return 1
              fi
              if printf '%s\n' "$sw_after" | grep -qxF "$sw_typed"; then
                refuse remove-refused "the flake still declares it, so the edit was reverted"
                "$GIT" -C "$DOTFILES" checkout -- flake.nix
                return 1
              fi

              commit_edit "chore(homebrew): undeclare ${commitNoun}$sw_typed" || return 1

              log "undeclared $sw_typed"
              return 0
            }
          '';

          commonTail = ''

            failures=0
            while IFS= read -r sw_request; do
              handle_request "$sw_request" || failures=$((failures + 1))
            done < "$requested"
            rm -f "$requested"

            # SAID OUT LOUD AS WELL. The last refusal is published where the hub
            # reads it (record_failure above), so the page the user pressed Run
            # on shows what happened rather than falling silently back to "No Run
            # Yet"; the notification stays, because it is the half that reaches
            # somebody who is no longer looking at that page, and the count it
            # carries is the one thing the single published document cannot say.
            if [ "$failures" -gt 0 ]; then
              log "FAILED: $failures request(s) changed nothing"
              notify "$failures request(s) changed nothing; see $LOG"
              exit 1
            fi

            log "done"
          '';
        in
        pkgs.writeShellScript operation
          (commonHead + (if declaring then declareBody else removeBody) + commonTail);

      declareFormula = softwareWatcher {
        operation = "declare-formula";
        title = "Declare Formula";
        kind = "formula";
        action = "declare";
        triggerDir = systemTriggerDir;
        failureArtifact = declareFormulaFailureArtifact;
        watcherLog = declareFormulaLog;
      };

      declareCask = softwareWatcher {
        operation = "declare-cask";
        title = "Declare Cask";
        kind = "cask";
        action = "declare";
        triggerDir = systemCaskTriggerDir;
        failureArtifact = declareCaskFailureArtifact;
        watcherLog = declareCaskLog;
      };

      undeclareFormula = softwareWatcher {
        operation = "undeclare-formula";
        title = "Undeclare Formula";
        kind = "formula";
        action = "remove";
        triggerDir = systemRemovalTriggerDir;
        failureArtifact = removeFormulaFailureArtifact;
        watcherLog = undeclareFormulaLog;
      };

      undeclareCask = softwareWatcher {
        operation = "undeclare-cask";
        title = "Undeclare Cask";
        kind = "cask";
        action = "remove";
        triggerDir = systemCaskRemovalTriggerDir;
        failureArtifact = removeCaskFailureArtifact;
        watcherLog = undeclareCaskLog;
      };
    in {
      # Package configuration
      nixpkgs.config.allowUnfree = true;
      
      # Suppress warnings (if supported)
      warnings = [];

      # User account configuration
      users.users.helixw = {
        home = "/Users/helixw";
        shell = pkgs.zsh;
      };

      # System-wide package installation
      environment.systemPackages = [
        pkgs.vim
        pkgs.mkalias
      ];

      # Homebrew package manager configuration
      homebrew = {
        enable = true;
        # Homebrew >=6 refuses formulae/casks from untrusted third-party taps
        # (HOMEBREW_REQUIRE_TAP_TRUST is on by default), so non-official taps
        # are declared trusted here. The oven-sh/bun tap has no explicit entry
        # (it is auto-tapped via the fully-qualified brew name), so trust is
        # set on the brew entry below instead.
        taps = [
          { name = "nikitabobko/tap"; trusted = true; }
          { name = "lzhgus/homebrew-tap"; trusted = true; }
        ];
        brews = [
          "mas"
          "starship"
          "fontconfig"
          "fastfetch"
          "gnupg"
          "pinentry-mac"
          # node is here for the private-office hub's node tooling rather than
          # for its own sake, and the consumers are named so a future cleanup
          # does not read it as spare: scripts/generate_report.mjs and
          # scripts/capture_page.mjs each carry a `#!/usr/bin/env node` shebang,
          # the biome binary the lint gates invoke by path carries one too, and
          # check_report_smoke.sh runs the report generator as a commit gate, so
          # removing node fails every commit in that repo closed. This formula
          # is also what puts npm and npx on PATH, which the editor's TypeScript
          # type acquisition uses. node@22 sat beside it until 2026-08-24 as the
          # Evidence build's pinned runtime; that build was retired on
          # 2026-08-23 and the pin went with it.
          "node"
          "python"
          "tree"
          "virtualenv"
          "git-secret"
          "gh"
          "uv"
          "lefthook"
          "shellcheck"
          "poppler"
          "btop"
          # The container runtime the private-office hub runs on. colima hosts
          # the Linux VM, docker is the client alone (the daemon lives in that
          # VM), and docker-compose is the CLI plugin the hub's `office setup`
          # drives. Verified live 2026-08-18 on formulae.brew.sh: colima 0.10.3
          # (MIT, depends on lima, which brew installs with it), docker 29.7.2
          # (Apache 2.0, "the daemon component is provided in a separate
          # formula" and is not wanted here), docker-compose 5.5.0 (Apache 2.0),
          # whose own caveat is that the CLI finds the plugin only once
          # ~/.docker/config.json names cliPluginsExtraDirs. That file is never
          # declared here: docker writes its current context into it, so a read
          # only copy would break `docker context`. The key is added instead by
          # the registerDockerCliPlugins home activation entry below, which
          # merges it in place and leaves every other key docker owns alone.
          # docker-buildx 0.36.1 (Apache 2.0, verified live 2026-08-23 on
          # formulae.brew.sh) joins them because compose refuses to build
          # without it, printing "Docker Compose requires buildx plugin to be
          # installed", which is what the private-office hub's compose build
          # hits. Its formula symlinks the plugin into that same
          # /opt/homebrew/lib/docker/cli-plugins, so the registration entry
          # below already reaches it and it needs no wiring of its own.
          "colima"
          "docker"
          "docker-buildx"
          "docker-compose"
          { name = "oven-sh/bun/bun"; trusted = true; }
        ];
        casks = [
          "font-jetbrains-mono-nerd-font"
          "raycast"
          "the-unarchiver"
          "sublime-text"
          "appcleaner"
          "1password"
          "nikitabobko/tap/aerospace"
          "scroll-reverser"
          "zoom"
          "visual-studio-code"
          "parsec"
          "ghostty"
          "altserver"
          "webcatalog"
          "notion"
          "ticktick"
          "iina"
          "transmission"
          "claude"
          "claude-code"
          "google-chrome"
          "superwhisper"
          "lzhgus/tap/capso"
          "discord"
          "calibre"
          "steam"
          "spotify"
          "fliqlo"
        ];
        masApps = {};
        onActivation.cleanup = "zap";
        onActivation.autoUpdate = true;
        onActivation.upgrade = true;
      };

      # Application symlink management
      system.activationScripts.applications.text = let
        env = pkgs.buildEnv {
          name = "system-applications";
          paths = config.environment.systemPackages;
          pathsToLink = [ "/Applications" ];
        };
      in pkgs.lib.mkForce ''
        echo "Setting up /Applications..." >&2
        rm -rf /Applications/Nix\ Apps
        mkdir -p /Applications/Nix\ Apps
        find ${env}/Applications -maxdepth 1 -type l -exec readlink '{}' + |
        while read -r src; do
          app_name=$(basename "$src")
          echo "Copying $src" >&2
          ${pkgs.mkalias}/bin/mkalias "$src" "/Applications/Nix Apps/$app_name"
        done
      '';

      # macOS system preferences configuration
      system.defaults = {
        # Dock configuration
        dock = {
          orientation = "right";
          show-recents = false;
          persistent-apps = [
            "/Applications/Ghostty.app"
            "/Applications/1Password.app"
            "/Applications/Ticktick.app"
            "/Applications/Microsoft Outlook.app"
            "/Applications/Zoom.us.app"
            "/Applications/Discord.app"
            "/Applications/Google Chrome.app"
            "/Applications/Notion.app"
            "/Applications/Visual Studio Code.app"
            "/Applications/Microsoft Excel.app"
            "/Applications/Microsoft Word.app"
            "/Applications/Microsoft PowerPoint.app"
            "/Applications/PDF Expert.app"
            "/System/Applications/App Store.app"
            "/System/Applications/System Settings.app"
            "/Applications/AppCleaner.app"
          ];
        };

        # Trackpad configuration
        trackpad = {
          Clicking = true;
          TrackpadRightClick = true;
        };

        # Login window configuration
        loginwindow = {
          GuestEnabled = false;
        };

        # Global domain preferences
        NSGlobalDomain = {
          "AppleICUForce24HourTime" = true;
          "AppleInterfaceStyle" = "Dark";
          "KeyRepeat" = 2;
          "_HIHideMenuBar" = false;
        };
      };

      # Custom user preferences (using activation script to avoid plist warnings)
      system.activationScripts.userDefaults.text = ''
        # Disable spotlight keyboard shortcuts
        /usr/bin/defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 '{ enabled = 0; }'
        /usr/bin/defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 65 '{ enabled = 0; }'
      '';

      # Set primary user for system-wide activation
      system.primaryUser = "helixw";

      # Touch ID for interactive sudo. reattach keeps it working inside tmux and
      # screen, which run outside the bootstrap session PAM ties the prompt to.
      security.pam.services.sudo_local = {
        enable = true;
        touchIdAuth = true;
        reattach = true;
      };

      # Unattended Software Update run, daily at 08:00. lockf(1) holds a kernel
      # flock for the whole run, so the interactive `dr` (which takes the same
      # file) cannot run brew at the same time; -t 0 means a collision skips this
      # run rather than queueing it, and the lock cannot go stale because the
      # kernel drops it when the holder dies.
      launchd.user.agents.morning-maintenance = {
        # `command` rather than a literal ProgramArguments: nix-darwin wraps it
        # as `/bin/sh -c "/bin/wait4path /nix/store && exec <command>"`, so a
        # fire at login cannot start before the Nix store is mounted and find
        # the script path missing.
        # -s silences lockf's own "already locked" line. It matters now that the
        # queue relaunches this job every 10 seconds through a collision (see
        # QueueDirectories below): without it, a 20 minute `dr` would write a
        # hundred error lines into the run log for a condition that is not an
        # error and resolves itself.
        command = "/usr/bin/lockf -s -t 0 -k ${maintenanceLock} /usr/bin/caffeinate -i ${morningMaintenance}";
        serviceConfig = {
          # Nothing here was asked for by the user at the keyboard, so launchd
          # throttles its CPU and I/O rather than letting it disturb the session.
          ProcessType = "Background";
          StartCalendarInterval = [ { Hour = 8; Minute = 0; } ];
          # The hub's on-demand path. A request added to this queue starts the
          # same job the schedule starts; which of the two fired is read from the
          # queue itself, so there is one script and one lock rather than a second
          # agent shadowing this one.
          QueueDirectories = [ maintenanceTriggerDir ];
          StandardOutPath = maintenanceLog;
          StandardErrorPath = maintenanceLog;
          # Catches up a missed 08:00 at the next login. The script's own date
          # stamp is what keeps that to one real run a day.
          RunAtLoad = true;
        };
      };

      # The hub's Shopping Research, run on demand and ONLY on demand. It is the
      # second consumer of the trigger idiom above and deliberately the plainer
      # one: no calendar entry and no RunAtLoad, because nothing here is owed on
      # a schedule and every run was pressed by a person seconds earlier.
      launchd.user.agents.shopping-research = {
        # lockf for the same reason the agent above takes one, and its scope is
        # stated rather than assumed: it serializes anything that takes THIS
        # file, which today is this job alone, launchd itself already running one
        # instance of a job at a time. What it does NOT cover is a hand-run
        # `office run shopping-enrichment` in a terminal, which takes no lock; a
        # sweep only ever writes items whose name is still null, so the cost of
        # that overlap is duplicated work on the user's own subscription rather
        # than a damaged store. -t 0 means a collision skips this launch, and -s
        # silences it: the queue below is what re-fires the job, every 10 seconds
        # until the lock frees, so the request is honoured rather than left
        # behind and the log stays free of a hundred lines saying so.
        command = "/usr/bin/lockf -s -t 0 -k ${shoppingLock} /usr/bin/caffeinate -i ${shoppingResearch}";
        serviceConfig = {
          ProcessType = "Background";
          # The whole trigger: this job runs for as long as its queue is not
          # empty, draining every request it finds and exiting when there are
          # none. QueueDirectories and never WatchPaths, for the reason the agent
          # above states in full and with the same live measurement behind it.
          QueueDirectories = [ shoppingTriggerDir ];
          StandardOutPath = shoppingLog;
          StandardErrorPath = shoppingLog;
        };
      };

      # The hub's four System routines, the remaining consumers of the trigger
      # idiom above and, like the second, on demand only.
      launchd.user.agents.declare-formula = {
        command = "${declareFormula}";
        serviceConfig = {
          ProcessType = "Background";
          QueueDirectories = [ systemTriggerDir ];
          StandardOutPath = declareFormulaLog;
          StandardErrorPath = declareFormulaLog;
        };
      };

      launchd.user.agents.declare-cask = {
        command = "${declareCask}";
        serviceConfig = {
          ProcessType = "Background";
          QueueDirectories = [ systemCaskTriggerDir ];
          StandardOutPath = declareCaskLog;
          StandardErrorPath = declareCaskLog;
        };
      };

      launchd.user.agents.undeclare-formula = {
        command = "${undeclareFormula}";
        serviceConfig = {
          ProcessType = "Background";
          QueueDirectories = [ systemRemovalTriggerDir ];
          StandardOutPath = undeclareFormulaLog;
          StandardErrorPath = undeclareFormulaLog;
        };
      };

      launchd.user.agents.undeclare-cask = {
        command = "${undeclareCask}";
        serviceConfig = {
          ProcessType = "Background";
          QueueDirectories = [ systemCaskRemovalTriggerDir ];
          StandardOutPath = undeclareCaskLog;
          StandardErrorPath = undeclareCaskLog;
        };
      };

