              };

              # ZSH shell configuration
              programs.zsh = {
                enable = true;
                dotDir = "${config.xdg.configHome}/zsh";
                enableCompletion = true;
                autosuggestion.enable = true;
                syntaxHighlighting.enable = true;

                initContent = ''
                  # Path configuration
                  export PATH="$HOME/bin:$PATH"
                  
                  # XDG Base Directory Specification
                  export XDG_CONFIG_HOME="$HOME/.config"
                  export XDG_DATA_HOME="$HOME/.local/share"
                  export XDG_CACHE_HOME="$HOME/.cache"
                  export XDG_STATE_HOME="$HOME/.local/state"
                  
                  # History settings
                  export HISTFILE="$ZDOTDIR/.zsh_history"
                  export HISTSIZE=10000
                  export SAVEHIST=10000

                  # Useful aliases
                  alias ll="ls -lah"
                  alias claude="caffeinate -dims claude"

                  # Rebuild the system, holding the same lock the scheduled
                  # Software Update agent takes, so the two never run brew
                  # against each other.
                  dr() {
                    local rc
                    # -s silences lockf, so a collision shows the message below
                    # rather than a raw "already locked" line as well.
                    /usr/bin/lockf -s -t 0 -k "${maintenanceLock}" \
                      sudo darwin-rebuild switch --flake ~/Code/dotfiles#aurelia
                    rc=$?
                    # 75 is EX_TEMPFAIL: lockf could not take the lock.
                    if [ $rc -eq 75 ]; then
                      echo "dr: a software update is running; try again shortly." >&2
                    fi
                    return $rc
                  }
                  
                  # Git aliases
                  alias gs="git status"
                  alias ga="git add"
                  alias gc="git commit"
                  alias gp="git push"
                  alias gl="git pull"
                  alias gd="git diff"
                  alias gb="git branch"
                  alias gco="git checkout"
                  alias glog="git log --oneline --graph"
                  alias grb="git rebase"
                  alias grs="git reset"
                  alias gst="git stash"

                  # Font configuration
                  export FONTCONFIG_FILE="$HOME/.config/fontconfig/fonts.conf"
                  
                  # Starship prompt
                  export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
                  eval "$(starship init zsh)"
                
                  # Prefer Homebrew Python over system Python
                  export PATH="/opt/homebrew/opt/python/libexec/bin:$PATH"
                  alias python=python3
                  alias pip=pip3

                  # Vim configuration
                  export VIMINIT='source $XDG_CONFIG_HOME/vim/vimrc'

